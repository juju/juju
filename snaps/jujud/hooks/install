#!/bin/sh

log() {
    echo "$@" >&2
    echo "$@" >> "$SNAP_COMMON/hook.log" 2>/dev/null || true
}

log "install: preparing controller-snap runtime directories"

mkdir -p "$SNAP_COMMON/sockets"
chmod 755 "$SNAP_COMMON/sockets"

mkdir -p "$SNAP_COMMON/logs"
chmod 755 "$SNAP_COMMON/logs"

mkdir -p "$SNAP_COMMON/.snap-init"
chmod 755 "$SNAP_COMMON/.snap-init"

mkdir -p "$SNAP_DATA"
chmod 755 "$SNAP_DATA"

log "install: done"
