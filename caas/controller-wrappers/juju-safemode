#!/bin/sh

runtime_conf="/var/lib/juju/controller/runtime.conf"
if [ ! -f "$runtime_conf" ]; then
  echo "controller not yet initialized (runtime.conf not found)" >&2
  exit 1
fi

controller_id=$(python3 -c "
import yaml
with open('$runtime_conf') as f:
    print(yaml.safe_load()['controller-id'])
" 2>/dev/null || true)
if [ -z "$controller_id" ]; then
  controller_id=0
fi

# Refuse to start if a safe-mode process is already running: a second
# instance cannot open the Dqlite database, and restarting jujud below
# would race the running one for the database.
if ps aux 2>/dev/null | grep -v grep | grep -q "safe-mode"; then
  echo "safe-mode is already running; stop it first" >&2
  exit 1
fi

# Stop the Pebble-managed jujud service before starting safe-mode,
# so the two processes don't compete for the Dqlite database.
#
# Pebble lives at /opt/pebble and is not on PATH inside the container.
# The jujud layer has startup:enabled, so pebble stop alone is
# insufficient: Pebble restarts the service immediately. We add a
# transient layer that disables auto-restart, then undo it after
# safe-mode exits.
pebble=/opt/pebble
safemode_layer=/var/lib/pebble/default/layers/002-safemode.yaml
if [ -x "$pebble" ]; then
  set -e
  # Clean up any stale disable layer from a previous interrupted run.
  rm -f "$safemode_layer"
  cat >"$safemode_layer" <<'EOF'
services:
  jujud:
    override: replace
    startup: disabled
EOF
  if $pebble services jujud 2>/dev/null | grep -q active; then
    echo "stopping jujud pebble service" >&2
    $pebble stop jujud
    # Poll until Pebble confirms the service is fully stopped.
    for i in $(seq 1 10); do
      if ! $pebble services jujud 2>/dev/null | grep -qE "active|backoff"; then
        break
      fi
      sleep 1
    done
  fi
  set +e
fi

# Run safe-mode. Catch SIGINT/SIGTERM/SIGHUP so the script is not killed
# before it can remove the disable layer and restart jujud.
#
# A background job started by a non-interactive shell inherits SIGINT
# set to ignored, and the Go runtime honors the inherited ignore, so
# safe-mode can never be interrupted with SIGINT. Always terminate it
# with SIGTERM, escalating to SIGKILL if it does not exit in time.
# A trapped signal also makes "wait" return immediately, so wait in a
# loop until the process has actually exited.
signal_safemode() {
  if [ -z "$kill_deadline" ]; then
    kill_deadline=$(( $(date +%s) + 30 ))
  fi
  kill -TERM "$jujud_pid" 2>/dev/null
}
trap signal_safemode INT TERM HUP
/opt/jujud safe-mode --data-dir /var/lib/juju/controller --controller-id "$controller_id" "$@" &
jujud_pid=$!
kill_deadline=""
while kill -0 "$jujud_pid" 2>/dev/null; do
  if [ -n "$kill_deadline" ] && [ "$(date +%s)" -ge "$kill_deadline" ]; then
    echo "safe-mode did not exit within 30s, sending SIGKILL" >&2
    kill -KILL "$jujud_pid" 2>/dev/null
  fi
  wait "$jujud_pid" 2>/dev/null || true
done
trap - INT TERM HUP

rm -f "$safemode_layer"
# Wait for the Dqlite abstract socket to be released before restarting
# the controller; if safe-mode is still holding it, jujud fails to
# create its Dqlite node ("failed to set bind address") and crash-loops.
for i in $(seq 1 30); do
  if ! grep -q "@dqlite-" /proc/net/unix 2>/dev/null; then
    break
  fi
  sleep 1
done
echo "restarting jujud service" >&2
$pebble start jujud
