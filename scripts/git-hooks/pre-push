#!/usr/bin/env bash
# Runs the documentation freshness check before pushing, but only when the push
# touches Go sources that feed the autogenerated reference documentation.
#
# This catches the common "edited a command's .go and forgot to regenerate the
# corresponding .md" mistake at the authoring step, before CI would have to.
# It performs no Go build when the push does not affect the docs, so pushes are
# not slowed down by unrelated work.
#
# Install with: make git-hooks
set -euo pipefail

# Paths that feed the autogenerated reference docs. Keep in sync with the
# check-docs paths-filter in .github/workflows/context-tests.yml.
# docs/** (prose) is deliberately excluded so prose edits don't trigger the
# Go build; the hook is about catching stale generated pages from source
# changes.
DOC_INPUT_RE='^(cmd/|controller/|environs/config/|internal/configschema/|internal/worker/uniter/runner/jujuc/|scripts/md-gen/|scripts/git-hooks/|Makefile|docs/Makefile|go.mod)'

repo_root="$(git rev-parse --show-toplevel)"

# pre-push is invoked with <remote> <url> on stdin, followed by lines of
# <local-ref> <local-sha> <remote-ref> <remote-sha>.
read -r _remote _url || true

touched_docs=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
	# Deleting a remote branch: nothing to check.
	if [[ "$remote_sha" =~ ^0+$ ]]; then
		continue
	fi

	# New branch / remote ref does not exist yet: compare against HEAD.
	if [[ "$local_sha" =~ ^0+$ ]] || [[ "$remote_sha" =~ ^0+$ ]]; then
		range="HEAD"
	else
		# If the merge-base cannot be resolved (e.g. history rewritten), play it
		# safe and run the check rather than silently skipping it.
		base="$(git merge-base "$local_sha" "$remote_sha" 2>/dev/null || true)"
		if [[ -z "$base" ]]; then
			range="HEAD"
		else
			range="$base..$local_sha"
		fi
	fi

	if git diff --name-only "$range" 2>/dev/null | grep -qE "$DOC_INPUT_RE"; then
		touched_docs=1
	fi
done

if [[ "$touched_docs" != "1" ]]; then
	exit 0
fi

echo "Changes affect autogenerated documentation; running docs freshness check..."
(cd "$repo_root/docs" && make verify-docs)
