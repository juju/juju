// principles.ggarch — diagrams for explanation/architecture-principles-v3.md
//
// Four diagrams:
//   1. "Forced structure"       — the two separations that force the architecture
//   2. "Notify then pull"       — watcher signal vs API fetch, incl. initial event
//   3. "Star topology"          — relations through the controller, no peer links
//   4. "Execution chain IAAS"   — provisioner → machine agent → unit agent → charm
//   5. "Execution chain K8s"    — same chain on Kubernetes

model "Principles" {

  nodes {

    // -----------------------------------------------------------------------
    // Diagram 1: Forced structure
    // -----------------------------------------------------------------------
    user        [type: person,        label: "User"]
    client      [type: juju-software, label: "Client"]
    controller  [type: juju-software, label: "Controller"]
    agent_a     [type: juju-software, label: "Agent"]
    workload_a  [type: external,      label: "Workload"]
    cloud_prov  [type: external,      label: "Cloud\n(AWS, GCP, K8s…)"]
    charmhub    [type: external,      label: "Charmhub"]

    // -----------------------------------------------------------------------
    // Diagram 2: Notify-then-pull
    // -----------------------------------------------------------------------
    db          [type: database,      label: "Controller DB\n(goal state)"]
    watcher     [type: juju-software, label: "Watcher\n(agent-side)"]
    agent_b     [type: juju-software, label: "Agent"]

    // -----------------------------------------------------------------------
    // Diagram 3: Star topology of relations
    // -----------------------------------------------------------------------
    ctrl_rel    [type: juju-software, label: "Controller\n(relation data)"]
    ua_a        [type: juju-software, label: "Unit agent\n(app A)"]
    ua_b        [type: juju-software, label: "Unit agent\n(app B)"]


    // -----------------------------------------------------------------------
    // Diagram 4: Execution chain — IAAS
    // -----------------------------------------------------------------------
    ctrl_iaas   [type: juju-software, label: "Controller"] {
      provisioner [type: juju-software, label: "Compute\nprovisioner",
                   lifecycle: persistent]
    }
    cloud_iaas  [type: external,      label: "Machine cloud\n(AWS / MAAS / LXD)"]
    machine_host [type: container,    label: "Provisioned machine"] {
      machine_agent [type: juju-software, label: "Machine agent\n(jujud)"] {
        unit_agent_iaas [type: juju-software, label: "Unit agent"] {
          uniter    [type: juju-software, label: "Uniter",
                     lifecycle: persistent]
          jujuc_srv [type: juju-software, label: "jujuc server",
                     lifecycle: ephemeral]
        }
      }
      charm_proc    [type: charm,    label: "Charm",
                     lifecycle: ephemeral]
      workload_iaas [type: workload, label: "Workload"]
    }

    // -----------------------------------------------------------------------
    // Diagram 5: Execution chain — K8s
    // -----------------------------------------------------------------------
    ctrl_k8s    [type: juju-software, label: "Controller"] {
      prov_k8s  [type: juju-software, label: "Pod scheduler\nmanifold",
                 lifecycle: persistent]
    }
    k8s_cloud   [type: external,      label: "Kubernetes"]
    unit_pod    [type: container,     label: "Unit pod"] {
      cont_agent [type: juju-software, label: "containeragent\n(unit + machine)"] {
        uniter_k8s [type: juju-software, label: "Uniter\n(resolver loop)"]
      }
      charm_k8s  [type: charm,         label: "Charm process",
                  lifecycle: ephemeral]
      jujuc_k8s  [type: juju-software, label: "jujuc server\n(Unix socket)",
                  lifecycle: ephemeral]
      pebble     [type: pebble,        label: "Pebble"]
      workload   [type: workload,      label: "Workload"]
    }
  }

  edges {
    // --- Forced structure ---
    user       -> client      [type: control, label: "sends commands to"]
    client     -> controller  [type: api,     label: "declares intent"]
    agent_a    -> controller  [type: stream,  label: "watches for changes on"]
    agent_a    -> workload_a  [type: control, label: "reconciles"]
    controller -> cloud_prov  [type: control, label: "provisions"]
    controller -> charmhub    [type: api,     label: "fetches charms"]

    // --- Notify-then-pull ---
    db      -> watcher  [type: event,   label: "fires signal\n(no data)"]
    watcher -> agent_b  [type: event]
    agent_b -> db       [type: api,     label: "fetch current state"]

    // --- Star topology ---
    // Show the pattern with two units only; three creates too many crossing edges.
    // Read is implied by notify+fetch in text; omit "read peers" label to reduce clutter.
    ua_a -> ctrl_rel  [type: data,   label: "write relation data"]
    ua_b -> ctrl_rel  [type: data,   label: "write relation data"]
    ctrl_rel -> ua_a  [type: event,  label: "notify"]
    ctrl_rel -> ua_b  [type: event,  label: "notify"]

    // --- Execution chain IAAS ---
    // Cloud sits above the controller (like diagram 1).
    // jujuc talks to the unit agent (not directly to the controller).
    provisioner     -> cloud_iaas      [type: control, label: "StartInstance"]
    cloud_iaas      -> provisioner     [type: event,   label: "instance ready"]
    machine_agent   -> ctrl_iaas       [type: stream,  label: "Juju API"]
    uniter          -> charm_proc      [type: control, label: "exec dispatch"]
    charm_proc      -> jujuc_srv       [type: ipc,     label: "hook command"]
    jujuc_srv       -> unit_agent_iaas [type: ipc,     label: "serves via unit agent"]
    charm_proc      -> workload_iaas   [type: control, label: "operates"]

    // --- Execution chain K8s ---
    prov_k8s    -> k8s_cloud   [type: control, label: "schedule pod"]
    k8s_cloud   -> prov_k8s   [type: event,   label: "pod ready"]
    cont_agent  -> ctrl_k8s   [type: stream,  label: "Juju API"]
    uniter_k8s  -> charm_k8s  [type: control, label: "exec dispatch"]
    charm_k8s   -> jujuc_k8s  [type: ipc,     label: "hook command"]
    jujuc_k8s   -> cont_agent [type: ipc,     label: "serves via agent"]
    charm_k8s   -> pebble     [type: api,     label: "Pebble API"]
    pebble      -> workload   [type: control, label: "supervises"]
  }

  behaviours {

    behaviour "Notify then pull" {
      db      -> watcher: async "change committed\n(signal only)"
      watcher -> agent_b: async "Changes() fires"
      agent_b -> db:      call  "fetch current state"
      db      -> agent_b: return "authoritative state"
      agent_b -> agent_b: self  "reconcile"
    }

    behaviour "Initial event" {
      agent_b -> db:      call  "subscribe watcher"
      db      -> watcher: return "watcher created"
      watcher -> agent_b: async "initial signal\n(baseline)"
      agent_b -> db:      call  "fetch current state"
      db      -> agent_b: return "authoritative state"
      agent_b -> agent_b: self  "reconcile"
    }

  }

  style {
    extends: juju
  }

}

// ==========================================================================
// Views
// ==========================================================================

// --------------------------------------------------------------------------
// 1. Forced structure
// --------------------------------------------------------------------------

diagram "Forced structure" from "Principles" {
  select {
    sizing: natural
    nodes: user client controller agent_a workload_a cloud_prov charmhub
    edges: type control type api type stream
  }
  positions {
    user       left-of client      gap: 20
    user       align-middle client
    client     left-of controller  gap: 20
    client     align-middle controller
    controller left-of agent_a     gap: 20
    controller align-middle agent_a
    agent_a    left-of workload_a  gap: 20
    agent_a    align-middle workload_a
    cloud_prov above controller    gap: 20
    cloud_prov align-centre controller
    charmhub   below controller    gap: 20
    charmhub   align-centre controller
  }
  annotations {
    box [nodes: "client controller",
         label: "intent & persistence",
         style: "dashed", color: "#888"]
    box [nodes: "agent_a workload_a",
         label: "execution",
         style: "dashed", color: "#888"]
    legend [position: "bottom-right",
            person: "operator",
            juju-software: "Juju process",
            external: "cloud / external",
            control: "manages / drives",
            api: "API call",
            stream: "watch (async)"]
  }
}

// --------------------------------------------------------------------------
// 2. Notify then pull (normal cycle)
// --------------------------------------------------------------------------

sequence "Notify then pull" from "Principles" {
  select { behaviour: "Notify then pull" }
}

// --------------------------------------------------------------------------
// 3. Initial event
// --------------------------------------------------------------------------

sequence "Initial event" from "Principles" {
  select { behaviour: "Initial event" }
}

// --------------------------------------------------------------------------
// 4. Star topology of relations
// --------------------------------------------------------------------------

diagram "Star topology" from "Principles" {
  select {
    sizing: natural
    nodes: ctrl_rel ua_a ua_b
    edges: type data type event
  }
  positions {
    // Controller centred above BOTH units (a fan, not chained to one
    // side): each pair's strokes run near-vertical, so the two
    // rotated labels of a pair stack side by side instead of
    // overlapping on converging diagonals.
    // Gap sized for the 'write relation data' label (110px) to
    // fit its vertical stroke without overflowing the pair.
    fan [ua_a ua_b] below ctrl_rel gap: 140 spacing: 60
  }
  annotations {
    box [nodes: "ctrl_rel",
         label: "all relation data lives here",
         style: "dashed", color: "#E95420"]
    legend [position: "bottom-right",
            juju-software: "Juju process",
            data: "write relation data",
            event: "notify (async)"]
  }
}

// --------------------------------------------------------------------------
// 5. Execution chain — IAAS (machine cloud)
// --------------------------------------------------------------------------

diagram "Execution chain IAAS" from "Principles" {
  select {
    sizing: natural
    nodes: ctrl_iaas cloud_iaas machine_host
    edges: type control type stream type ipc type event
  }
  positions {
    ctrl_iaas    left-of machine_host   gap: 80
    ctrl_iaas    align-middle machine_host
    cloud_iaas   above ctrl_iaas        gap: 50
    cloud_iaas   align-centre ctrl_iaas
    machine_host direction: down
    machine_agent direction: down
    // Gap sized for the 'exec dispatch' label on the uniter->charm
    // stroke and the 'hook command' label on the charm->jujuc stroke.
    charm_proc below machine_agent gap: 60
    unit_agent_iaas direction: right
  }
  annotations {
    legend [position: "bottom-right",
            juju-software: "Juju process",
            container: "Juju-owned machine",
            charm: "charm",
            workload: "workload",
            external: "cloud / external",
            control: "manages / drives",
            stream: "watch (async)",
            ipc: "hook command (Unix socket)",
            event: "async notification"]
  }
}
// --------------------------------------------------------------------------
// 6. Execution chain — Kubernetes
// --------------------------------------------------------------------------


diagram "Execution chain K8s" from "Principles" {
  select {
    sizing: natural
    nodes: ctrl_k8s k8s_cloud unit_pod
    edges: type control type stream type ipc type event type api
  }
  positions {
    ctrl_k8s  left-of unit_pod   gap: 80
    ctrl_k8s  align-middle unit_pod
    k8s_cloud above ctrl_k8s    gap: 50
    k8s_cloud align-centre ctrl_k8s
    unit_pod  direction: down
    cont_agent direction: right
    // Gap sized for the incident labels ('exec dispatch', 'hook
    // command', 'serves via agent') to separate around the charm.
    charm_k8s below cont_agent gap: 60
    // jujuc offset right of the charm: its "serves via agent" edge to
    // cont_agent runs up the clear right corridor instead of riding
    // its label across the charm box; pebble stays in the left column
    // under the charm so the Pebble API edge stays inside the pod.
    jujuc_k8s right-of charm_k8s gap: 30
    pebble    below charm_k8s    gap: 30
    pebble    align-centre charm_k8s
  }
  annotations {
    legend [position: "bottom-right",
            juju-software: "Juju process",
            container: "Juju-owned pod",
            charm: "charm",
            pebble: "Pebble supervisor",
            workload: "workload",
            external: "cloud / external",
            control: "manages / drives",
            api: "API call",
            stream: "watch (async)",
            ipc: "hook command (Unix socket)",
            event: "async notification"]
  }
}
