// Provisioning a machine, from the 4.1 code:
//   internal/worker/computeprovisioner/provisioner_task.go:358-394 (a new
//     machine is seen), :530-575 (classifyMachine), :1314-1423 (queue starts),
//     :1435-1605 (doStartMachine: status provisioning, StartInstance across
//     zones, ten attempts ten seconds apart, record the instance)
//   domain/machine/state/machine_cloud_instance.go:160-322 (record once)
//   internal/worker/machiner/machiner.go:96-102 (started);
//   apiserver/observer/agentpresence.go:105-143 (login sets presence)
model "MachineProvisioning" {

  nodes {
    pv_provisioner [type: juju-software, label: "Compute provisioner"]
    pv_db          [type: database, label: "Model database"]
    pv_cloud       [type: external, label: "Cloud"]
    pv_agent       [type: juju-software, label: "Machine agent"]
  }

  edges {
    pv_provisioner -> pv_db          [type: api]
    pv_provisioner -> pv_cloud       [type: api]
    pv_cloud       -> pv_agent       [type: control]
    pv_agent       -> pv_db          [type: api]
  }

  behaviours {
    behaviour "provision-machine" {
      pv_provisioner -> pv_db:          call "see a new machine and read its provisioning information"
      pv_provisioner -> pv_db:          call "set the instance status to allocating"
      pv_provisioner -> pv_cloud:       call "start an instance, trying each availability zone, up to ten attempts"
      pv_cloud       -> pv_provisioner: return "instance"
      pv_provisioner -> pv_db:          call "record the instance ID, hardware, and nonce"
      pv_cloud       -> pv_agent:       async "the instance downloads and starts the machine agent"
      pv_agent       -> pv_db:          call "log in, which records its presence, and report the status started"
    }
  }

  style { extends: juju }
}

sequence "Provisioning a machine" from "MachineProvisioning" {
  select { behaviour: "provision-machine" }
}

