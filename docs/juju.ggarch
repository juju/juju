// --------------------------------------------------------------------------
// Reference: relation kind taxonomy (docs/reference/relation.md, § Types
// of relation; ADR-011 §2) — the is-a trie, POSITIVE discriminators
// (reviewer verdicts round 26 part 2) and a FLAT STAR (round 27): the
// four self-standing kinds hang straight off the root, straight diagonal
// connectors (no `routing: orthogonal`), root centred over the leaf row
// by the equal-gap bracket. The hollow triangle lands on the parent; the
// edge label is the discriminator. Declared positions (the trie's shape
// IS the argument); retires the hand-drawn excalidraw.
// --------------------------------------------------------------------------
diagram "Types of relation" from "Juju" {
  select {
    nodes: rel_kind rel_kind_peer rel_kind_sub
           rel_kind_reg rel_kind_cmr
    edges: type generalization
    sizing: uniform
  }
  positions {
    // Root-apex star (verdicts round 27): the four kinds hang straight
    // off the root — NO `routing: orthogonal`, every is-a edge is a
    // direct diagonal. The `fan ... below` centres the leaf row on the
    // root's exact cx (even-N: (cx3 + cx4) == 2 * cx(root)).
    fan [rel_kind_peer rel_kind_sub rel_kind_reg rel_kind_cmr] below rel_kind gap: 60 spacing: 200
  }
  annotations {
    legend [position: "bottom-right", generalization: "is a"]
  }
}

// --------------------------------------------------------------------------
// Reference: relation attributes (docs/reference/relation.md, § Relation
// attributes; ADR-011 §3) — the persistence portrait sliced from
// domain/schema/model/sql/0024-relation.sql: the ten stored tables of the
// relation story, every FK drawn exactly once from its fk: field to the
// target's key. The four derived views (v_application_endpoint,
// v_relation_endpoint, v_relation_endpoint_identifier, v_relation_status)
// are read models with no pointers of their own — named in the caption,
// not drawn. Declared positions: the FK spine reads parent-left /
// child-right, settings clusters hang under their owner.
// --------------------------------------------------------------------------
diagram "Relation attributes" from "Juju" {
  select {
    routing: orthogonal
    nodes: ra_relation ra_endpoint ra_unit ra_unit_setting
           ra_setting_archive ra_app_setting ra_status ra_status_type
           ra_app_endpoint ra_unit_boundary ra_life ra_scope
    edges: type data
  }
  positions {
    // The relation spine, top to bottom: relation -> endpoint -> unit.
    ra_life            above ra_relation  gap: 100
    ra_life            align-centre ra_relation
    ra_endpoint        below ra_relation  gap: 100
    ra_endpoint        align-centre ra_relation
    ra_unit            below ra_status    gap: 50
    ra_unit            align-centre ra_status
    // Left: scope and the endpoint boundary flank the spine's west.
    ra_scope           above ra_app_endpoint gap: 50
    ra_scope           align-centre ra_app_endpoint
    ra_app_endpoint    left-of ra_relation gap: 90
    ra_app_endpoint    align-middle ra_relation
    // Right of the spine: the status cluster, then the unit and its
    // boundary; the wide gap leaves the hash-free lane at c4 clear.
    ra_status          right-of ra_relation gap: 90
    ra_status          align-middle ra_relation
    ra_status_type     right-of ra_status gap: 80
    ra_status_type     align-middle ra_status
    ra_unit_boundary   right-of ra_unit gap: 80
    ra_unit_boundary   align-middle ra_unit
    // Settings hang under their owner. The archive sits on the top
    // row beside life: its pointer targets the relation, and the top
    // row gives the edge a clear horizontal into relation's west face.
    ra_app_setting     below ra_endpoint gap: 100
    ra_app_setting     align-centre ra_endpoint
    ra_unit_setting    below ra_unit gap: 100
    ra_unit_setting    align-centre ra_unit
    ra_setting_archive right-of ra_life gap: 60
    ra_setting_archive align-middle ra_life
  }
  annotations {
    legend [position: "bottom-right",
            record: "database record",
            data: "schema association (stored pointer; multiplicity in label)"]
  }
}

