// --------------------------------------------------------------------------
// Reference: the machine data model (docs/reference/machine.md §3,
// ADR-011) — the stored pointers around the machine record. Grounds:
// 0018-machine.sql + 0017-machine-cloud-instance.sql; net_node shared
// with units (unit.net_node_uuid = machine.net_node_uuid).
// --------------------------------------------------------------------------
diagram "Machine attributes" from "Juju" {
  select {
    nodes: ma_machine ma_instance ma_parent ma_status
           ma_instance_status net_node_rec
    edges: type data
  }
  positions {
    // West chain: parent adjacent to machine (its two edges take the
    // west face); the net-node identity hangs BELOW the parent, so
    // machine's edge to it drops under the parent instead of through.
    ma_parent          left-of ma_machine gap: 110
    ma_parent          align-middle ma_machine
    net_node_rec       below ma_parent gap: 60
    net_node_rec       align-centre ma_parent
    // East chain: status adjacent (east face); the base hangs below
    // the status, so machine's edge to it drops under the status.
    ma_status          right-of ma_machine gap: 90
    ma_status          align-middle ma_machine
    // South chain: the instance under the machine; its own status
    // under it; the availability zone beside the instance.
    ma_instance        below ma_machine gap: 100
    ma_instance        align-centre ma_machine
    ma_instance_status below ma_instance gap: 100
    ma_instance_status align-centre ma_instance
  }
  annotations {
    legend [position: "bottom-right",
            record: "database record",
            data: "schema association (stored pointer; multiplicity in label)"]
  }
}

