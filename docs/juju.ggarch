// Fetching a resource for a unit, from the 4.1 code.
//   step 1: api/agent/uniter/resource.go:62-70 (the unit agent's GET),
//     apiserver/apiserver.go:1132-1134 (route), :916 (unit and application
//     agents only), :984 and :1773-1786 (the named unit must be the caller's
//     unit, or a unit of the caller's application)
//   step 2: internal/resource/opener.go:177-198 (application resource, then
//     the unit's own resource), :198-210 (stored blob is returned at once)
//   step 3: opener.go:233-256 (download from Charmhub by revision; a local
//     charm or an upload that has not arrived returns not found or not
//     provisioned, :223-231, :112-116)
//   step 4: opener.go:258-275, domain/resource/service/resource.go:468-547
//     (store the blob and who retrieved it)
//   step 5: apiserver/internal/handlers/resources/unitresources.go:84-96
//     (headers and body)
//   step 6: unitresources.go:103-107, domain/resource/state/resource.go:1108
//     (SetUnitResource; a failure is only logged)
//   step 7: api/agent/uniter/resource.go:73, apiserver/facades/agent/
//     resourceshookcontext/unitfacade.go:106 (GetResourceInfo),
//     internal/worker/uniter/runner/context/resources/context.go:46-56
model "UnitResourceFetch" {

  nodes {
    urf_agent [type: juju-software, label: "Unit agent"]
    urf_ctl   [type: juju-software, label: "Controller"]
    urf_hub   [type: external, label: "Charmhub"]
  }

  edges {
    urf_agent -> urf_ctl [type: api]
    urf_ctl   -> urf_hub [type: api]
  }

  behaviours {
    behaviour "fetching-unit-resource" {
      urf_agent -> urf_ctl:   call "a hook runs resource-get: ask for the resource by name"
      urf_ctl   -> urf_ctl:   self "find the stored content"
      urf_ctl   -> urf_hub:   call "download the revision"
      urf_hub   -> urf_ctl:   return "the content"
      urf_ctl   -> urf_ctl:   self "store the content and who retrieved it"
      urf_ctl   -> urf_agent: return "the content and its fingerprint"
      urf_ctl   -> urf_ctl:   self "record that the unit uses the resource"
      urf_agent -> urf_ctl:   call "get the resource's details"
      urf_agent -> urf_agent: self "check the fingerprint and write the file"
    }
  }

  style { extends: juju }
}

sequence "Fetching a resource for a unit" from "UnitResourceFetch" {
  select { behaviour: "fetching-unit-resource" }
}
