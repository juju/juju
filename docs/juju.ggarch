// Upgrade state changes, from the 4.1 code:
//   domain/upgrade/state/state.go:220-268 (StartUpgrade: created -> started)
//   domain/upgrade/state/state.go:269-283 (SetDBUpgradeCompleted: started -> db-completed)
//   domain/upgrade/state/state.go:285-300 (SetDBUpgradeFailed: started -> error)
//   domain/upgrade/state/state.go:308-387 (SetControllerDone: db-completed ->
//     steps-completed when every node is done)
model "UpgradeStateChanges" {

  nodes {
    us_created     [label: "created"]
    us_started     [label: "started"]
    us_dbcompleted [label: "db-completed"]
    us_stepsdone   [label: "steps-completed"]
    us_error       [label: "error"]
  }

  behaviours {
    behaviour "upgrade-state" {
      us_created     -> us_started:     call "every node registered"
      us_started     -> us_dbcompleted: call "schema patches applied"
      us_started     -> us_error:       call "the database part fails"
      us_dbcompleted -> us_stepsdone:   call "the last node finishes its steps"
    }
  }

  edges {
    us_created     -> us_started     [type: control]
    us_started     -> us_dbcompleted [type: control]
    us_started     -> us_error       [type: control]
    us_dbcompleted -> us_stepsdone   [type: control]
  }

  style { extends: juju }

}

state "Upgrade state" from "UpgradeStateChanges" {
  select { behaviour: "upgrade-state" }
}

