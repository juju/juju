diagram "Cloud database schema" from "JujuSchema" {
  select {
    nodes: cloud cloud_type cloud_region cloud_ca_cert cloud_auth_type model cloud_credential
           context: cloud_credential model
    edges: type data
    except: model -> cloud_region
    except: model -> cloud_credential
    labels: hidden
    fields: hidden
    sizing: uniform
    routing: orthogonal
  }
  positions {
    cloud_region left-of cloud gap: 70
    cloud_region align-middle cloud
    model right-of cloud gap: 70
    model align-middle cloud
    cloud_type above cloud gap: 60
    cloud_type align-centre cloud
    cloud_auth_type below cloud gap: 60
    cloud_auth_type align-centre cloud
    cloud_ca_cert below cloud_region gap: 60
    cloud_ca_cert align-centre cloud_region
    cloud_credential below model gap: 60
    cloud_credential align-centre model
    cloud_type same-size cloud
    cloud_region same-size cloud
    model same-size cloud
    cloud_auth_type same-size cloud
    cloud_ca_cert same-size cloud
    cloud_credential same-size cloud
  }
}

