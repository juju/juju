// --------------------------------------------------------------------------
// Data model: full spine — controller DB + model DB, provenance walk
// --------------------------------------------------------------------------

diagram "Data model (full spine)" from "Juju" {
  select {
    nodes: user_rec controller_rec cloud_rec credential_rec model_rec
           application_rec charm_rec unit_rec machine_rec relation_rec endpoint_rec
    // The unit-pin edge (unit.charm_uuid) is scoped to the Charm
    // origins view: it landed after this declared view's geometry was
    // tuned, and re-threading it here flips the synthesized variant
    // into a cramped solve (measured: 2.24/2.14 detours).
    except: unit_rec -> charm_rec
  routing: orthogonal
  }
  positions {
    // Spine, left to right:
    // controller → model → application → unit → machine
    controller_rec  left-of model_rec        gap: 90
    controller_rec  align-middle model_rec
    model_rec       left-of application_rec gap: 90
    model_rec       align-middle application_rec
    application_rec left-of unit_rec        gap: 90
    application_rec align-middle unit_rec
    unit_rec        left-of machine_rec     gap: 90
    unit_rec        align-middle machine_rec
    // Controller DB cluster above the spine
    user_rec        above controller_rec    gap: 50
    user_rec        align-centre controller_rec
    cloud_rec       above model_rec         gap: 60
    cloud_rec       align-centre model_rec
    // credential stacks in model's column (its anchor: "uses 0..1") —
    // the Scrabble rule: a column absorbs its satellites, so the
    // credential edges are one vertical plus two short approaches
    credential_rec  below model_rec         gap: 40
    credential_rec  align-centre model_rec
    // Charm above the application
    charm_rec       above application_rec    gap: 50
    charm_rec       align-centre application_rec
    // Relation endpoints below the application
    endpoint_rec    below application_rec    gap: 50
    endpoint_rec    align-centre application_rec
    relation_rec    below endpoint_rec       gap: 50
    relation_rec    align-centre endpoint_rec
  }
  annotations {
    box [nodes: "user_rec controller_rec cloud_rec credential_rec model_rec",
         label: "controller database", style: "dashed", color: "#888"]
    box [nodes: "application_rec charm_rec unit_rec machine_rec relation_rec endpoint_rec",
         label: "model database", style: "dashed", color: "#888"]
    legend [position: "bottom-right",
            record: "database record",
            data: "schema association (semantic direction, multiplicity in label)"]
  }
}

// --------------------------------------------------------------------------
// Worker tree — the machine-cloud execution chain
// --------------------------------------------------------------------------

diagram "Worker tree (machine cloud)" from "Juju" {
  select {
    nodes: controller machine_agent unit_agent uniter charm
    // The chain only: who hosts and runs whom. The watch/upgrade
    // channels and the hook-call round trip are sequence material.
    except: machine_agent -> controller unit_agent -> controller [type: stream] unit_agent -> charm charm -> unit_agent
  }
  positions {
    controller    above machine_agent gap: 60
    controller    align-centre machine_agent
    machine_agent above unit_agent    gap: 60
    machine_agent align-centre unit_agent
    unit_agent    above uniter        gap: 60
    unit_agent    align-centre uniter
    uniter        above charm         gap: 60
    uniter        align-centre charm
  }
  annotations {
    legend [position: "bottom-right",
            juju-software: "Juju process",
            control: "drives / hosts / dispatches"]
  }
}

// --------------------------------------------------------------------------
// Worker tree — the controller dependency engine
// --------------------------------------------------------------------------

diagram "Worker tree (controller)" from "Juju" {
  select {
    // First node anchors the layout at (0, 0) — the top-left corner.
    routing: orthogonal
    nodes: provider_tracker provider_services
           provisioner model_worker_manager
           undertaker
           agent_worker db_accessor change_stream domain_services
           api_server http_server
           object_store
           lease_manager primary_flag lease_expiry
  }
  positions {
    // Spine — the capability ladder, packed top to bottom.
    agent_worker     above db_accessor     gap: 60
    agent_worker     align-centre db_accessor
    db_accessor      above change_stream   gap: 60
    db_accessor      align-centre change_stream
    change_stream    above domain_services gap: 60
    change_stream    align-centre domain_services
    domain_services  above api_server      gap: 60
    domain_services  align-centre api_server
    api_server       above http_server     gap: 60
    api_server       align-centre http_server
    // Direct pair (the domain-services -> db-accessor edge skips a rung);
    // declared so its label gap resolves on the vertical axis only.
    db_accessor      above domain_services gap: 180

    // Provider column (far left) — cloud handles, packed.
    provider_tracker above provider_services gap: 60
    provider_tracker align-centre provider_services

    // Model column — per-model workers, packed.
    provisioner      above model_worker_manager gap: 60
    provisioner      align-centre model_worker_manager

    // Lease column (far right) — manager at the base, election above.
    primary_flag     above lease_manager gap: 60
    primary_flag     align-centre lease_manager
    lease_expiry     above primary_flag gap: 60
    lease_expiry     align-centre primary_flag

    // Wings — single nodes tied to their spine row.
    undertaker       left-of domain_services gap: 120
    undertaker       align-middle domain_services
    object_store     left-of lease_manager   gap: 110
    object_store     align-middle api_server

    // Column order: providers | models | undertaker | spine | store | leases.
    provider_tracker    left-of provisioner          gap: 60
    provisioner         left-of undertaker           gap: 60
    undertaker          left-of agent_worker         gap: 100
    api_server          left-of object_store         gap: 150
    lease_manager       right-of db_accessor         gap: 150
    provider_services   left-of change_stream        gap: 150
    provider_services   left-of model_worker_manager gap: 140
    model_worker_manager left-of domain_services     gap: 150
  }
  annotations {
    box [nodes: "provisioner model_worker_manager",
         label: "model workers\n(one set per model)",
         style: "dashed", color: "#888"]
    legend [position: "bottom-right",
            juju-software: "worker (dependency engine)",
            control: "depends on (capability)",
            stream: "watches"]
  }
}

// --------------------------------------------------------------------------
// Cross-model integration — the record picture
// --------------------------------------------------------------------------

diagram "Cross-model relation (CMR)" from "Juju" {
  select {
    nodes: application_rec offer_rec offer_connection_rec remote_app_rec
           relation_rec endpoint_rec model_rec external_controller_rec
    routing: orthogonal
    sizing: uniform
  }
  positions {
    // The dependency chain reads top-down in dependency order
    // (relation HAS endpoints; endpoints BELONG TO application), so
    // every within-cluster edge is an axis-aligned straight — the
    // old arrangement sandwiched endpoint between application and
    // relation and forced corner-hugging dodges.
    // Scrabble grid (user, review round 4, refined: prefer top-down /
    // left-right arrows). Col2 is the association stack flowing DOWN
    // (remote application -> relation -> endpoint -> application);
    // model's column absorbs the external controller (row 5); the
    // offering region hangs right of application. Every edge points
    // down or right.
    model_rec        left-of application_rec       gap: 90
    model_rec        align-middle application_rec
    relation_rec     below remote_app_rec          gap: 60
    relation_rec     align-centre remote_app_rec
    endpoint_rec     below relation_rec            gap: 60
    endpoint_rec     align-centre relation_rec
    application_rec  below endpoint_rec            gap: 60
    application_rec  align-centre endpoint_rec
    offer_rec        right-of application_rec      gap: 90
    offer_rec        align-middle application_rec
    offer_connection_rec right-of offer_rec        gap: 90
    offer_connection_rec align-middle offer_rec
    external_controller_rec below model_rec         gap: 60
    external_controller_rec align-centre model_rec
  }
  annotations {
    box [nodes: "offer_rec offer_connection_rec",
         label: "offering model (database)", style: "dashed", color: "#E95420"]
    box [nodes: "application_rec endpoint_rec relation_rec remote_app_rec model_rec",
         label: "consuming model (database)", style: "dashed", color: "#888"]
    legend [position: "bottom-right",
            record: "database record",
            data: "schema association (semantic direction, multiplicity in label)"]
  }
}


