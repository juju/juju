// The phases of a model migration and the changes the code allows
// (core/migration/phase.go, validTransitions). Labels are the names the
// controller stores (model_migration_phase).
model "MigrationPhases" {

  nodes {
    mg_quiesce [label: "quiesce"]
    mg_import [label: "import"]
    mg_validation [label: "validation"]
    mg_success [label: "success"]
    mg_logtransfer [label: "log-transfer"]
    mg_reap [label: "reap"]
    mg_reapfailed [label: "reap-failed"]
    mg_done [label: "done"]
    mg_abort [label: "abort"]
    mg_abortdone [label: "abort-done"]
  }

  behaviours {
    behaviour "migration-phase" {
      mg_quiesce -> mg_import: call "next phase"
      mg_import -> mg_validation: call "next phase"
      mg_validation -> mg_success: call "next phase"
      mg_success -> mg_logtransfer: call "next phase"
      mg_logtransfer -> mg_reap: call "next phase"
      mg_reap -> mg_done: call "next phase"
      mg_reap -> mg_reapfailed: call "next phase"
      mg_validation -> mg_abort: call "abort"
      mg_import -> mg_abort: call "abort"
      mg_quiesce -> mg_abort: call "abort"
      mg_abort -> mg_abortdone: call "next phase"
    }
  }

  edges {
    mg_quiesce -> mg_import [type: control]
    mg_quiesce -> mg_abort [type: control]
    mg_import -> mg_validation [type: control]
    mg_import -> mg_abort [type: control]
    mg_validation -> mg_success [type: control]
    mg_validation -> mg_abort [type: control]
    mg_success -> mg_logtransfer [type: control]
    mg_logtransfer -> mg_reap [type: control]
    mg_reap -> mg_done [type: control]
    mg_reap -> mg_reapfailed [type: control]
    mg_abort -> mg_abortdone [type: control]
  }

  style { extends: juju }
}

state "Model migration phase" from "MigrationPhases" {
  select { behaviour: "migration-phase" }
}

// Sources of the steps, in order (worker, facade or state code under
// internal/worker/migrationmaster, internal/worker/migrationminion and
// apiserver/facades/client/controller):
//   request and prechecks: InitiateMigration, runMigrationPrechecks
//   quiesce, validation, success: migrationmaster doQUIESCE, doVALIDATION,
//     doSUCCESS; minion doQUIESCE, doVALIDATION, doSUCCESS
//   import: transferModel (ImportV2, UploadBinaries)
//   machines: checkTargetMachines (CheckMachines); activate: activateModel
//   cloud resources: transferResources (AdoptResources)
//   reap: doREAP (MarkModelAsGone)
model "MigrationSequence" {

  nodes {
    ms_client     [type: juju-software, label: "Client"]
    ms_source     [type: juju-software, label: "Source controller"]
    ms_target     [type: juju-software, label: "Target controller"]
    ms_agents     [type: juju-software, label: "Model agents"]
    ms_cloud      [type: external, label: "Cloud"]
  }

  edges {
    ms_client -> ms_source [type: api]
    ms_source -> ms_target [type: api]
    ms_source -> ms_agents [type: api]
    ms_agents -> ms_source [type: api]
    ms_agents -> ms_target [type: api]
    ms_target -> ms_cloud  [type: api]
    ms_source -> ms_source [type: api]
  }

  behaviours {
    behaviour "migration-request" {
      ms_client -> ms_source: call "request the migration"
      ms_source -> ms_source: self "check access and run the source prechecks"
      ms_source -> ms_target: call "connect, and run the target prechecks"
      ms_target -> ms_source: return "ok"
      ms_source -> ms_client: return "migration ID"
    }
    behaviour "migration-quiesce-import" {
      ms_source -> ms_agents: call "quiesce: stop work and report"
      ms_agents -> ms_source: return "ready"
      ms_source -> ms_target: call "run the prechecks again"
      ms_target -> ms_source: return "ok"
      ms_source -> ms_target: call "import: send the model, charms, agent binaries, and resources"
      ms_target -> ms_source: return "model imported, not active"
    }
    behaviour "migration-validation" {
      ms_source -> ms_agents: call "validation: connect to the target and report"
      ms_agents -> ms_target: call "log in and validate"
      ms_agents -> ms_source: return "validated"
      ms_source -> ms_target: call "check the machines, then activate the model"
      ms_target -> ms_cloud: call "list the model's machines"
      ms_cloud -> ms_target: return "instances"
      ms_target -> ms_source: return "machines match, model prepared"
    }
    behaviour "migration-success-reap" {
      ms_source -> ms_agents: call "success: report, then switch to the target"
      ms_agents -> ms_source: return "reported"
      ms_source -> ms_target: call "take over the cloud resources"
      ms_source -> ms_target: call "log-transfer: copy the model's logs"
      ms_source -> ms_source: self "reap: remove the model and keep a redirect record"
    }
  }

  style { extends: juju }
}

sequence "Migration request" from "MigrationSequence" {
  select { behaviour: "migration-request" }
}

sequence "Migration quiesce and import" from "MigrationSequence" {
  select { behaviour: "migration-quiesce-import" }
}

sequence "Migration validation" from "MigrationSequence" {
  select { behaviour: "migration-validation" }
}

sequence "Migration success and reap" from "MigrationSequence" {
  select { behaviour: "migration-success-reap" }
}

