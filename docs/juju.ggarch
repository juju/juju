  }
  positions {
    application_rec left-of unit_rec        gap: 60
    application_rec align-middle unit_rec
    unit_rec        right-of application_rec gap: 60
    unit_rec        left-of machine_rec      gap: 60
    unit_rec        align-middle machine_rec
    charm_rec       above application_rec    gap: 50
    charm_rec       align-centre application_rec
    endpoint_rec    below application_rec    gap: 50
    endpoint_rec    align-centre application_rec
