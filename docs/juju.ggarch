// The Juju model for the documentation.
//
// One model serves every page: nodes and edges are declared once and the
// views (diagrams and sequences) select what each page needs. Pages embed
// a view with the {ggarch} directive:
//
//   ```{ggarch}
//   :file: ../juju.ggarch
//   :view: The insight
//   ```
//
// Colour means ownership (orange = Juju, grey = outside Juju); a cloud
// badge marks an entity as deployed on a node from a cloud. See the
// ggarch SKILL.md "Visual grammar".

model "Juju" {

  nodes {
    // Actors and systems around Juju.
    // Before Juju enters the story the person is an SRE; from "The insight"
    // on, the same person is a Juju user (the account the controller knows).
    sre      [type: person,        label: "SRE"]
    user     [type: person,        label: "User"]
    client   [type: juju-software, label: "Client"]
    charmhub [type: external,      label: "Charmhub"]
    cloud    [type: external,      label: "Cloud"]
    clouds   [type: external,      label: "Clouds\n(AWS, MAAS, OpenStack,\nKubernetes, …)",
              collective: cloud]

    controller [type: juju-software, label: "Controller"]

    ssh_controller [type: juju-software, label: "Controller",
                    abstracts: "controller"] {
      ssh_gateway [type: juju-software,
                   label: "SSH tunnel server\n(port 17022)"]
      ssh_session [type: juju-software, label: "Target SSH server\n(virtual host key)"]
      ssh_api     [type: juju-software, label: "API server\n(port 17070)"]
      ssh_db      [type: database, label: "Model database\n(tunnel request)"]
    }
    ssh_target [type: external, label: "Machine or unit"]
    ssh_processing_controller [type: juju-software, label: "Controller",
                               abstracts: "controller"] {
      ssh_decrypt [label: "🔓 decrypt"]
      ssh_proxy   [type: juju-software, label: "SSH Proxy\n(inspect/process)"]
      ssh_encrypt [label: "🔒 encrypt"]
    }
    ssh_machine [type: node, label: "Machine", deployed: true] {
      ssh_machine_agent [type: juju-software, label: "Machine agent"]
      ssh_machine_server [type: external, label: "Machine SSH server"]
    }
    ssh_k8s_api [type: external, label: "Kubernetes API server"]
    ssh_pod     [type: node, label: "Unit pod", deployed: true] {
      ssh_container [type: workload, label: "Target container"]
    }

    // "The insight" shows Juju as one piece between the user and the
    // applications. "The topology" opens it into a client and a controller
    // and brings in the clouds and Charmhub.
    juju     [type: juju-software, label: "Juju"]

    // The entity chain: a model holds applications and an application runs
    // as units. Models and applications are logical entities (dotted). A
    // model lives on a cloud (the cloud badge), because that is where its
    // workers get nodes from. A unit is a node with the unit agent, the
    // charm and the workload on it.
    model [type: entity, label: "Model", deployed: true] {
      application [type: entity, label: "Application"] {
        unit_node [type: node, label: "Unit"] {
          unit_agent [type: juju-software, label: "Unit agent"]
          charm      [type: charm,         label: "Charm"]
          workload   [type: workload,      label: "Workload"]
        }
      }
    }

    // The applications as the user sees them: on nodes from a cloud,
    // outside Juju. "The problem" and "The insight" draw them.
    bare_node [type: external, label: "Node"]
    bare_applications [type: external, label: "Applications", deployed: true,
                       collective: bare_node]

    // Two unit agents, for integration.
    agent_foo [type: juju-software, label: "Unit agent\n(foo/0)"]
    agent_bar [type: juju-software, label: "Unit agent\n(bar/0)"]

    // The tutorial's chat service: three applications that do not form a
    // whole. Each is an abstraction with the Juju mark: a unit agent and a
    // charm run behind it.
    mattermost [type: charmed-entity, label: "Mattermost"]
    postgresql [type: charmed-entity, label: "PostgreSQL"]
    certs      [type: charmed-entity, label: "Certs"]
  }

  edges {
    // The problem
    sre  -> bare_applications [type: control, label: "operates"]

    // The insight
    user         -> juju              [type: api,     label: "declares intent to"]
    juju         -> bare_applications [type: control, label: "operates"]

    // The topology: declare a goal state, persist it, reconcile with it
    user         -> client       [type: api,    label: "declares goal state to"]
    client       -> controller   [type: api,    label: "persists goal state in"]
    controller   -> clouds       [type: api,    label: "gets nodes from"]
    controller   -> charmhub     [type: api,    label: "gets charms from"]

    // The topology
    unit_agent -> controller [type: stream,  label: "reconciles state with"]
    unit_agent -> charm      [type: control, label: "runs"]
    charm      -> workload   [type: control, label: "operates"]

    // The steps
    client     -> client     [type: api,    label: "saves to"]
    client     -> cloud      [type: api,    label: "gets a node from"]
    controller -> cloud      [type: api,    label: "gets nodes from"]
    agent_foo  -> controller [type: stream, label: "watches"]
    agent_bar  -> controller [type: stream, label: "watches"]

    // The tutorial: the unit agents of the chat applications watch the
    // controller, as every unit agent does.
    mattermost -> controller [type: stream, label: "unit agents watch"]
    postgresql -> controller [type: stream, label: "unit agents watch"]
    certs      -> controller [type: stream, label: "unit agents watch"]

    client -> ssh_gateway [type: stream, label: "outer SSH tunnel"]
    client -> ssh_session [type: stream, label: "inner SSH session"]
    client -> ssh_api [type: api, label: "fetches expected host keys"]
    ssh_gateway -> ssh_session [type: ipc, label: "forwards inner SSH"]
    ssh_session -> ssh_target [type: stream, label: "proxies session"]
    ssh_controller -> ssh_k8s_api [type: stream, label: "exec stream"]
    ssh_k8s_api -> ssh_container [type: stream, label: "executes in"]
    ssh_session -> ssh_db [type: api, label: "1. stores tunnel request"]
    ssh_machine_agent -> ssh_db [type: stream, label: "2. observes request via API"]
    ssh_machine_agent -> ssh_api [type: stream, label: "3. opens reverse tunnel"]
    ssh_session -> ssh_machine_server [type: stream, label: "4. SSH over reverse tunnel"]
    client -> ssh_processing_controller [type: stream]
    ssh_processing_controller -> ssh_target [type: stream]
    ssh_decrypt -> ssh_proxy [type: control]
    ssh_proxy -> ssh_encrypt [type: control]
  }

  behaviours {
    behaviour "add-cloud" {
      user   -> client: call "juju add-cloud"
      client -> client: self "save the cloud definition"
      client -> user:   return "cloud added"
    }
    behaviour "add-credential" {
      user   -> client: call "juju add-credential"
      client -> client: self "save the credential"
      client -> user:   return "credential added"
    }
    behaviour "bootstrap" {
      user       -> client:     call "juju bootstrap"
      client     -> cloud:      call "get a node"
      cloud      -> client:     return "node ready"
      client     -> controller: call "install and start the controller"
      controller -> controller: self "initialize the database"
      controller -> client:     return "API ready"
    }
    // Kubernetes clouds: one command adds the cluster and its credential from
    // the kubeconfig, and the cluster runs the controller and the application
    // pods, so there is no node to get and nothing to install by hand.
    behaviour "add-k8s" {
      user   -> client: call "juju add-k8s"
      client -> client: self "save the cloud and its credential"
      client -> user:   return "cloud added"
    }
    behaviour "bootstrap-k8s" {
      user       -> client:     call "juju bootstrap"
      client     -> cloud:      call "create the controller StatefulSet"
      cloud      -> client:     return "created"
      client     -> controller: call "wait for the API"
      controller -> controller: self "initialize the database"
      controller -> client:     return "API ready"
    }
    behaviour "add-model" {
      user       -> client:     call "juju add-model"
      client     -> controller: call "declare the model"
      controller -> controller: self "persist it in the database"
      controller -> client:     return "model ready"
    }
    behaviour "deploy" {
      user       -> client:     call "juju deploy foo"
      client     -> controller: call "declare the application"
      controller -> controller: self "persist it in the database"
      controller -> charmhub:   call "get the charm"
      controller -> cloud:      call "get a node"
      cloud      -> controller: return "node ready"
      controller -> unit_agent: async "watcher fires"
      unit_agent -> controller: call "fetch the current state"
      unit_agent -> charm:      call "run the install hook"
      unit_agent -> controller: call "report the result"
    }
    behaviour "deploy-k8s" {
      user       -> client:     call "juju deploy foo"
      client     -> controller: call "declare the application"
      controller -> controller: self "persist it in the database"
      controller -> charmhub:   call "get the charm"
      controller -> cloud:      call "create the application's pods"
      cloud      -> controller: return "pods created"
      controller -> unit_agent: async "watcher fires"
      unit_agent -> controller: call "fetch the current state"
      unit_agent -> charm:      call "run the install hook"
      unit_agent -> controller: call "report the result"
    }
    behaviour "config" {
      user       -> client:     call "juju config foo key=value"
      client     -> controller: call "declare the new value"
      controller -> controller: self "persist it in the database"
      controller -> unit_agent: async "watcher fires"
      unit_agent -> controller: call "fetch the current state"
      unit_agent -> charm:      call "run the config-changed hook"
      unit_agent -> controller: call "report the result"
    }
    behaviour "integrate" {
      user       -> client:     call "juju integrate foo bar"
      client     -> controller: call "declare the integration"
      controller -> controller: self "persist it in the database"
      controller -> agent_foo:  async "watcher fires"
      controller -> agent_bar:  async "watcher fires"
      agent_foo  -> controller: call "fetch state, run relation hooks"
      agent_bar  -> controller: call "fetch state, run relation hooks"
    }
  }

  style { extends: juju }
}

diagram "The problem" from "Juju" {
  // The user and the applications, which run on nodes from clouds (the
  // cloud badge). The clouds themselves are a detail of "The topology".
  select {
    nodes: sre bare_applications
    edges: type control
    sizing: uniform
  }
  positions {
    sre               left-of bare_applications gap: 120
    sre               align-middle bare_applications
  }
}

diagram "The insight" from "Juju" {
  select {
    nodes: user juju bare_applications
    edges: type api type control
    sizing: uniform
  }
  positions {
    user              left-of juju gap: 100
    user              align-middle juju
    bare_applications right-of juju gap: 100
    bare_applications align-middle juju
  }
}

diagram "The topology" from "Juju" {
  select {
    nodes: user client controller clouds charmhub model
    edges: type api type stream type control
  }
  positions {
    user     left-of client gap: 90
    user     align-middle client
    client   left-of controller gap: 90
    client   align-middle controller
    clouds   above controller gap: 110
    clouds   align-centre controller
    charmhub below controller gap: 110
    charmhub align-centre controller
    model    right-of controller gap: 120
    model    align-middle controller
  }
}

// Scaffolded from the 4.1 controller DDL: ggarch scaffold controller.ddl --db controller --tables user_public_ssh_key,model_authorized_keys
model "SSHKeySchema" {

  nodes {
    auth_type [type: record, label: "auth_type",
                 ground: "controller:auth_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text", null: true]
      }
    }

    cloud [type: record, label: "cloud",
                 ground: "controller:cloud"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        cloud_type_id [label: "cloud_type_id", type: "int", fk: true]
        endpoint [label: "endpoint", type: "text"]
        identity_endpoint [label: "identity_endpoint", type: "text", null: true]
        storage_endpoint [label: "storage_endpoint", type: "text", null: true]
        skip_tls_verify [label: "skip_tls_verify", type: "bool"]
      }
    }

    cloud_credential [type: record, label: "cloud_credential",
                 ground: "controller:cloud_credential"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        auth_type_id [label: "auth_type_id", type: "text", fk: true]
        owner_uuid [label: "owner_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        revoked [label: "revoked", type: "bool", null: true]
        invalid [label: "invalid", type: "bool", null: true]
        invalid_reason [label: "invalid_reason", type: "text", null: true]
      }
    }

    cloud_region [type: record, label: "cloud_region",
                 ground: "controller:cloud_region"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        endpoint [label: "endpoint", type: "text", null: true]
        identity_endpoint [label: "identity_endpoint", type: "text", null: true]
        storage_endpoint [label: "storage_endpoint", type: "text", null: true]
      }
    }

    cloud_type [type: record, label: "cloud_type",
                 ground: "controller:cloud_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text"]
      }
    }

    life [type: record, label: "life",
                 ground: "controller:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    model [type: context-record, label: "Model",
                 ground: "controller:model"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        activated [label: "activated", type: "bool"]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        cloud_region_uuid [label: "cloud_region_uuid", type: "text", fk: true, null: true]
        cloud_credential_uuid [label: "cloud_credential_uuid", type: "text", fk: true, null: true]
        model_type_id [label: "model_type_id", type: "int", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        name [label: "name", type: "text"]
        qualifier [label: "qualifier", type: "text"]
      }
    }

    model_authorized_keys [type: record, label: "Model\nauthorization",
                 ground: "controller:model_authorized_keys"] {
      fields {
        model_uuid [label: "model_uuid", type: "text", fk: true]
        user_public_ssh_key_id [label: "user_public_ssh_key_id", type: "int", fk: true]
      }
    }

    model_type [type: record, label: "model_type",
                 ground: "controller:model_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text"]
      }
    }

    ssh_fingerprint_hash_algorithm [type: record, label: "Fingerprint hash\nalgorithm",
                 ground: "controller:ssh_fingerprint_hash_algorithm"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        algorithm [label: "algorithm", type: "text"]
      }
    }

    user [type: context-record, label: "User",
                 ground: "controller:user"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        display_name [label: "display_name", type: "text", null: true]
        external [label: "external", type: "bool"]
        removed [label: "removed", type: "bool"]
        created_by_uuid [label: "created_by_uuid", type: "text", fk: true]
        created_at [label: "created_at", type: "timestamp"]
      }
    }

    user_public_ssh_key [type: record, label: "SSH key",
                 ground: "controller:user_public_ssh_key"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        comment [label: "comment", type: "text"]
        fingerprint_hash_algorithm_id [label: "fingerprint_hash_algorithm_id", type: "int", fk: true]
        fingerprint [label: "fingerprint", type: "text"]
        public_key [label: "public_key", type: "text"]
        user_uuid [label: "user_uuid", type: "text", fk: true]
      }
    }

  }

  edges {
    cloud.cloud_type_id -> cloud_type.id [type: data]
    cloud_credential.cloud_uuid -> cloud.uuid [type: data]
    cloud_credential.auth_type_id -> auth_type.id [type: data]
    cloud_credential.owner_uuid -> user.uuid [type: data]
    cloud_region.cloud_uuid -> cloud.uuid [type: data]
    model.cloud_uuid -> cloud.uuid [type: data]
    model.cloud_region_uuid -> cloud_region.uuid [type: data]
    model.cloud_credential_uuid -> cloud_credential.uuid [type: data]
    model.model_type_id -> model_type.id [type: data]
    model.life_id -> life.id [type: data]
    model_authorized_keys.user_public_ssh_key_id -> user_public_ssh_key.id [type: data]
    model_authorized_keys.model_uuid -> model.uuid [type: data]
    user.created_by_uuid -> user.uuid [type: data]
    user_public_ssh_key.fingerprint_hash_algorithm_id -> ssh_fingerprint_hash_algorithm.id [type: data]
    user_public_ssh_key.user_uuid -> user.uuid [type: data]
  }

  style { extends: juju }

}

// Importing SSH keys: the chronology of one import, happy path. Each step
// cites the 4.1 code that performs it:
//   1 apiserver/facades/client/keymanager/keymanager.go:271 (ImportKeys)
//   2 keymanager.go:272-277 (checkCanWrite, ChangeAllowed)
//   3 keymanager.go:298 (GetUserByName)
//   4 domain/keymanager/service/service.go:276 -> internal/ssh/importer/importer.go:35-62
//     (resolver by scheme: "gh" and "lp", importer.go:61-65)
//   5 service.go:298-312 (parse each key; reserved comment refused)
//   6 service.go:324 -> domain/keymanager/state/state.go:309-313
//     (INSERT ... ON CONFLICT DO NOTHING into model_authorized_keys)
//   7 keymanager.go:321-380 (one ErrorResult per key source)
model "SSHKeyImport" {

  nodes {
    ik_client     [type: juju-software, label: "Client"]
    ik_controller [type: juju-software, label: "Controller"]
    ik_source     [type: external, label: "Launchpad or GitHub"]
    ik_database   [type: database, label: "Controller database"]
  }

  edges {
    ik_client     -> ik_controller [type: api]
    ik_controller -> ik_controller [type: api]
    ik_controller -> ik_source     [type: api]
    ik_controller -> ik_database   [type: api]
  }

  behaviours {
    behaviour "import-ssh-keys" {
      ik_client     -> ik_controller: call "import keys from a source (lp:<name> or gh:<name>)"
      ik_controller -> ik_controller: self "check access and the change block, then find the user"
      ik_controller -> ik_source:     call "fetch the account's public keys"
      ik_source     -> ik_controller: return "public keys"
      ik_controller -> ik_controller: self "parse each key and refuse a reserved comment"
      ik_controller -> ik_database:   call "store the keys and authorize them on the model (keys already there are skipped)"
      ik_database   -> ik_controller: return "done"
      ik_controller -> ik_client:     return "one result per source"
    }
  }

  style { extends: juju }
}

diagram "SSH key data model" from "SSHKeySchema" {
  select {
    nodes: user user_public_ssh_key ssh_fingerprint_hash_algorithm model_authorized_keys model
    edges: type data
    labels: hidden
    fields: hidden
    sizing: uniform
    routing: orthogonal
  }
  positions {
    user_public_ssh_key right-of user gap: 70
    user_public_ssh_key align-middle user
    ssh_fingerprint_hash_algorithm below user_public_ssh_key gap: 50
    ssh_fingerprint_hash_algorithm align-centre user_public_ssh_key
    model_authorized_keys right-of user_public_ssh_key gap: 70
    model_authorized_keys align-middle user_public_ssh_key
    model right-of model_authorized_keys gap: 70
    model align-middle model_authorized_keys
    ssh_fingerprint_hash_algorithm same-size user_public_ssh_key
    user same-size user_public_ssh_key
    model same-size user_public_ssh_key
    model_authorized_keys same-size user_public_ssh_key
  }
}

sequence "Importing SSH keys" from "SSHKeyImport" {
  select { behaviour: "import-ssh-keys" }
}

// Scaffolded by tools/build_page_schema.py from the 4.1 controller DDL.
model "CloudSchema" {

  nodes {
    auth_type [type: record, label: "Authentication\ntype",
                 ground: "controller:auth_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text", null: true]
      }
    }

    cloud [type: record, label: "Cloud",
                 ground: "controller:cloud"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        cloud_type_id [label: "cloud_type_id", type: "int", fk: true]
        endpoint [label: "endpoint", type: "text"]
        identity_endpoint [label: "identity_endpoint", type: "text", null: true]
        storage_endpoint [label: "storage_endpoint", type: "text", null: true]
        skip_tls_verify [label: "skip_tls_verify", type: "bool"]
      }
    }

    cloud_auth_type [type: record, label: "Admitted\nauthentication type",
                 ground: "controller:cloud_auth_type"] {
      fields {
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        auth_type_id [label: "auth_type_id", type: "int", fk: true]
      }
    }

    cloud_ca_cert [type: record, label: "CA certificate",
                 ground: "controller:cloud_ca_cert"] {
      fields {
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        ca_cert [label: "ca_cert", type: "text"]
      }
    }

    cloud_credential [type: context-record, label: "Credential",
                 ground: "controller:cloud_credential"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        auth_type_id [label: "auth_type_id", type: "text", fk: true]
        owner_uuid [label: "owner_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        revoked [label: "revoked", type: "bool", null: true]
        invalid [label: "invalid", type: "bool", null: true]
        invalid_reason [label: "invalid_reason", type: "text", null: true]
      }
    }

    cloud_region [type: record, label: "Region",
                 ground: "controller:cloud_region"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        name [label: "name", type: "text"]
        endpoint [label: "endpoint", type: "text", null: true]
        identity_endpoint [label: "identity_endpoint", type: "text", null: true]
        storage_endpoint [label: "storage_endpoint", type: "text", null: true]
      }
    }

    cloud_type [type: record, label: "Cloud type",
                 ground: "controller:cloud_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text"]
      }
    }

    life [type: record, label: "life",
                 ground: "controller:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    model [type: context-record, label: "Model",
                 ground: "controller:model"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        activated [label: "activated", type: "bool"]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        cloud_region_uuid [label: "cloud_region_uuid", type: "text", fk: true, null: true]
        cloud_credential_uuid [label: "cloud_credential_uuid", type: "text", fk: true, null: true]
        model_type_id [label: "model_type_id", type: "int", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        name [label: "name", type: "text"]
        qualifier [label: "qualifier", type: "text"]
      }
    }

    model_type [type: record, label: "model_type",
                 ground: "controller:model_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text"]
      }
    }

    user [type: record, label: "user",
                 ground: "controller:user"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        display_name [label: "display_name", type: "text", null: true]
        external [label: "external", type: "bool"]
        removed [label: "removed", type: "bool"]
        created_by_uuid [label: "created_by_uuid", type: "text", fk: true]
        created_at [label: "created_at", type: "timestamp"]
      }
    }

  }

  edges {
    cloud.cloud_type_id -> cloud_type.id [type: data]
    cloud_auth_type.cloud_uuid -> cloud.uuid [type: data]
    cloud_auth_type.auth_type_id -> auth_type.id [type: data]
    cloud_ca_cert.cloud_uuid -> cloud.uuid [type: data]
    cloud_credential.cloud_uuid -> cloud.uuid [type: data]
    cloud_credential.auth_type_id -> auth_type.id [type: data]
    cloud_credential.owner_uuid -> user.uuid [type: data]
    cloud_region.cloud_uuid -> cloud.uuid [type: data]
    model.cloud_uuid -> cloud.uuid [type: data]
    model.cloud_region_uuid -> cloud_region.uuid [type: data]
    model.cloud_credential_uuid -> cloud_credential.uuid [type: data]
    model.model_type_id -> model_type.id [type: data]
    model.life_id -> life.id [type: data]
    user.created_by_uuid -> user.uuid [type: data]
  }

  style { extends: juju }

}


diagram "Cloud data model" from "CloudSchema" {
  select {
    nodes: cloud cloud_type cloud_region cloud_ca_cert cloud_auth_type model cloud_credential
    edges: type data
    except: model -> cloud_region
    except: model -> cloud_credential
    labels: hidden
    fields: hidden
    sizing: uniform
    routing: orthogonal
  }
  positions {
    cloud_region left-of cloud gap: 70
    cloud_region align-middle cloud
    model right-of cloud gap: 70
    model align-middle cloud
    cloud_type above cloud gap: 60
    cloud_type align-centre cloud
    cloud_auth_type below cloud gap: 60
    cloud_auth_type align-centre cloud
    cloud_ca_cert below cloud_region gap: 60
    cloud_ca_cert align-centre cloud_region
    cloud_credential below model gap: 60
    cloud_credential align-centre model
    cloud_type same-size cloud
    cloud_region same-size cloud
    model same-size cloud
    cloud_auth_type same-size cloud
    cloud_ca_cert same-size cloud
    cloud_credential same-size cloud
  }
}

// The tutorial grows the same picture in three steps: the pieces Juju needs,
// the user who logs in, and the applications the controller operates.
diagram "Tutorial setup" from "Juju" {
  select {
    nodes: client controller cloud charmhub
    edges: type api
    except: client -> cloud
    except: client -> client
    labels: hidden
    sizing: uniform
  }
  positions {
    client   left-of controller gap: 100
    client   align-middle controller
    cloud    above controller gap: 80
    cloud    align-centre controller
    charmhub below controller gap: 80
    charmhub align-centre controller
  }
}

diagram "Tutorial user" from "Juju" {
  select {
    nodes: user client controller cloud charmhub
    edges: type api
    except: client -> cloud
    except: client -> client
    labels: hidden
    sizing: uniform
  }
  positions {
    user     left-of client gap: 100
    user     align-middle client
    client   left-of controller gap: 100
    client   align-middle controller
    cloud    above controller gap: 80
    cloud    align-centre controller
    charmhub below controller gap: 80
    charmhub align-centre controller
  }
}

diagram "Tutorial deployment" from "Juju" {
  select {
    nodes: user client controller cloud charmhub mattermost postgresql certs
    edges: type api type stream
    except: client -> cloud
    except: client -> client
    labels: hidden
    sizing: uniform
  }
  positions {
    user       left-of client gap: 80
    user       align-middle client
    client     left-of controller gap: 80
    client     align-middle controller
    cloud      above controller gap: 80
    cloud      align-centre controller
    charmhub   below controller gap: 80
    charmhub   align-centre controller
    postgresql right-of controller gap: 120
    postgresql align-middle controller
    mattermost above postgresql gap: 30
    mattermost align-centre postgresql
    certs      below postgresql gap: 30
    certs      align-centre postgresql
  }
}

sequence "juju add-cloud"      from "Juju" { select { behaviour: "add-cloud" } }
sequence "juju add-credential" from "Juju" { select { behaviour: "add-credential" } }
sequence "juju bootstrap"      from "Juju" { select { behaviour: "bootstrap" } }
sequence "juju add-k8s"        from "Juju" { select { behaviour: "add-k8s" } }
sequence "juju bootstrap (Kubernetes)" from "Juju" { select { behaviour: "bootstrap-k8s" } }
sequence "juju add-model"      from "Juju" { select { behaviour: "add-model" } }
sequence "juju deploy"         from "Juju" { select { behaviour: "deploy" } }
sequence "juju deploy (Kubernetes)" from "Juju" { select { behaviour: "deploy-k8s" } }
sequence "juju config"         from "Juju" { select { behaviour: "config" } }
sequence "juju integrate"      from "Juju" { select { behaviour: "integrate" } }

diagram "SSH proxy overview" from "Juju" {
  select {
    nodes: client ssh_processing_controller ssh_target
    edges: type stream type control
    labels: hidden
    sizing: uniform
  }
  positions {
    client left-of ssh_processing_controller gap: 100
    client align-middle ssh_processing_controller
    ssh_target right-of ssh_processing_controller gap: 100
    ssh_target align-middle ssh_processing_controller
    ssh_processing_controller direction: down
    ssh_proxy below ssh_decrypt gap: 40
    ssh_proxy align-centre ssh_decrypt
    ssh_encrypt below ssh_proxy gap: 40
    ssh_encrypt align-centre ssh_proxy
  }
}

diagram "SSH proxy connections" from "Juju" {
  select {
    nodes: client ssh_gateway ssh_session ssh_target
    edges: type stream type ipc
    except: client -> ssh_session
  }
  positions {
    client left-of ssh_gateway gap: 160
    client align-middle ssh_gateway
    ssh_session below ssh_gateway gap: 100
    ssh_session align-centre ssh_gateway
    ssh_target right-of ssh_session gap: 160
    ssh_target align-middle ssh_session
  }
  annotations {
    box [nodes: "ssh_gateway ssh_session", label: "Juju controller",
         style: "solid", color: "#E95420", padding: 24]
  }
}

diagram "SSH proxy Kubernetes" from "Juju" {
  select {
    nodes: ssh_controller ssh_k8s_api ssh_pod
    collapse: ssh_controller
    edges: type stream
  }
  positions {
    ssh_controller left-of ssh_k8s_api gap: 100
    ssh_controller align-middle ssh_k8s_api
    ssh_pod right-of ssh_k8s_api gap: 100
    ssh_pod align-middle ssh_k8s_api
  }
}

diagram "SSH proxy machine reverse tunnel" from "Juju" {
  select {
    nodes: ssh_session ssh_db ssh_api ssh_machine_server ssh_machine_agent
    edges: type api type stream
    routing: orthogonal
    sizing: uniform
  }
  positions {
    ssh_db below ssh_session gap: 80
    ssh_db align-centre ssh_session
    ssh_api below ssh_db gap: 80
    ssh_api align-centre ssh_db
    ssh_machine_server right-of ssh_session gap: 240
    ssh_machine_server align-middle ssh_session
    ssh_machine_agent below ssh_machine_server gap: 80
    ssh_machine_agent align-centre ssh_machine_server
    ssh_machine_agent align-middle ssh_api
  }
  annotations {
    box [nodes: "ssh_session ssh_db ssh_api", label: "Juju controller",
         style: "solid", color: "#E95420", padding: 24]
    box [nodes: "ssh_machine_server ssh_machine_agent", label: "Machine",
         style: "solid", color: "#E95420", padding: 24]
  }
}
