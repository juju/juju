      }
    }

    model_namespace [type: record, label: "Namespace",
                 ground: "controller:model_namespace"] {
      fields {
        namespace [label: "namespace", type: "text"]
        model_uuid [label: "model_uuid", type: "text", fk: true, uk: true]
      }
    }

    model_type [type: record, label: "Model type",
                 ground: "controller:model_type"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        type [label: "type", type: "text"]
      }
    }

    user [type: record, label: "user",
                 ground: "controller:user"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        name [label: "name", type: "text"]
        display_name [label: "display_name", type: "text", null: true]
        external [label: "external", type: "bool"]
        removed [label: "removed", type: "bool"]
        created_by_uuid [label: "created_by_uuid", type: "text", fk: true]
        created_at [label: "created_at", type: "timestamp"]
      }
    }

    model_db_life [type: record, label: "life",
                 ground: "model:life"] {
      fields {
        id [label: "id", type: "int", pk: true, null: true]
        value [label: "value", type: "text"]
      }
    }

    model_copy [type: record, label: "Model identity copy",
                 ground: "model:model"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        controller_uuid [label: "controller_uuid", type: "text"]
        name [label: "name", type: "text"]
        qualifier [label: "qualifier", type: "text"]
        type [label: "type", type: "text"]
        cloud [label: "cloud", type: "text"]
        cloud_type [label: "cloud_type", type: "text"]
        cloud_region [label: "cloud_region", type: "text", null: true]
        credential_owner [label: "credential_owner", type: "text", null: true]
        credential_name [label: "credential_name", type: "text", null: true]
        is_controller_model [label: "is_controller_model", type: "bool", null: true]
      }
    }

    model_config [type: record, label: "Model configuration",
                 ground: "model:model_config"] {
      fields {
        value [label: "value", type: "text"]
      }
    }

    model_constraint [type: record, label: "Model constraints",
                 ground: "model:model_constraint"] {
      fields {
        model_uuid [label: "model_uuid", type: "text", pk: true, fk: true]
        constraint_uuid [label: "constraint_uuid", type: "text"]
      }
    }

    model_life [type: record, label: "Model life copy",
                 ground: "model:model_life"] {
      fields {
        model_uuid [label: "model_uuid", type: "text", pk: true, fk: true]
        life_id [label: "life_id", type: "text", fk: true]
      }
    }

    model_migrating [type: record, label: "Migrating marker",
                 ground: "model:model_migrating"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        model_uuid [label: "model_uuid", type: "text", fk: true, uk: true]
      }
    }

  }

  edges {
    cloud.cloud_type_id -> cloud_type.id [type: data]
    cloud_credential.cloud_uuid -> cloud.uuid [type: data]
    cloud_credential.auth_type_id -> auth_type.id [type: data]
    cloud_credential.owner_uuid -> user.uuid [type: data]
    cloud_region.cloud_uuid -> cloud.uuid [type: data]
    model.cloud_uuid -> cloud.uuid [type: data]
    model.cloud_region_uuid -> cloud_region.uuid [type: data]
    model.cloud_credential_uuid -> cloud_credential.uuid [type: data]
    model.model_type_id -> model_type.id [type: data]
    model.life_id -> life.id [type: data]
    model_migration_export.target_controller_uuid -> external_controller.uuid [type: data]
    model_migration_export.current_phase_id -> model_migration_phase.id [type: data]
    model_migration_import.phase_type_id -> model_migration_import_phase_type.id [type: data]
    model_namespace.model_uuid -> model.uuid [type: data]
    user.created_by_uuid -> user.uuid [type: data]
    model_constraint.model_uuid -> model_copy.uuid [type: data]
    model_life.model_uuid -> model_copy.uuid [type: data]
    model_life.life_id -> model_db_life.id [type: data]
    model_migrating.model_uuid -> model_copy.uuid [type: data]
    // No foreign key in the DDL: a migration outlives the model's row.
    model_migration_export.model_uuid -> model.uuid [type: data]
  }

  style { extends: juju }

}

