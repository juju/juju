// Juju architecture — GROUNDED twin (juju3): every record node and
// schema association carries a `ground:` pointer to its codebase
// locus (DDL table / FK column, or code path), verified by
// tools/check-grounding.py. One-directional rule: everything drawn
// exists in the schema; curation is declared, never silent.
// juju.ggarch (stable) and juju2.ggarch (spike) unchanged. See the
// ggarch HANDOFF, "Work plan: the juju2 spike".
//
// Views are declared here too; diagrams in the .md files reference them
// by name via :view: or :sequence:.

model "Juju" {

  nodes {
    // -----------------------------------------------------------------------
    // Actors
    // -----------------------------------------------------------------------
    user [type: person, label: "User"]

    // -----------------------------------------------------------------------
    // Client-side
    // -----------------------------------------------------------------------
    client [type: juju-software, label: "Client"]

    // -----------------------------------------------------------------------
    // Controller — abstract (used in high-level diagrams)
    // -----------------------------------------------------------------------
    controller [type: juju-software, label: "Controller"]

    // -----------------------------------------------------------------------
    // Controller pod (K8s deployment — detailed)
    // -----------------------------------------------------------------------
    controller_pod [type: container, label: "Controller pod",
                    abstracts: "controller"] {
      jujud [type: juju-software, label: "Controller agent\n(jujud, Dqlite)"]
    }

    // -----------------------------------------------------------------------
    // Unit pod (K8s deployment — detailed)
    // -----------------------------------------------------------------------
    unit_pod [type: container, label: "Unit pod"] {
      charm_container [type: container, label: "Charm container"] {
        unit_agent [type: juju-software, label: "Unit agent"]
        charm      [type: charm,         label: "Charm"]
      }
      workload_container [type: container, label: "Workload container"] {
        pebble   [type: pebble,   label: "Pebble (init)"]
        workload [type: workload, label: "Workload service(s)"]
      }
    }

    // -----------------------------------------------------------------------
    // Agents — abstract (used in high-level diagrams)
    // -----------------------------------------------------------------------
    agents [type: juju-software, label: "Agents"]

    // -----------------------------------------------------------------------
    // External
    // -----------------------------------------------------------------------
    k8s      [type: external, label: "Kubernetes cloud"]
    charmhub [type: external, label: "Charmhub"]
    clouds   [type: external, label: "Clouds\n(AWS, GCP, K8s…)",
              collective: cloud]
    cloud    [type: external, label: "Cloud"]   // generic cloud for machine sequences

    // -----------------------------------------------------------------------
    // Workload — abstract (used in high-level diagrams)
    // -----------------------------------------------------------------------
    world [type: workload, label: "Real world"]

    // -----------------------------------------------------------------------
    // Charmed applications — abstract
    // -----------------------------------------------------------------------
    apps [type: charm, label: "Charmed applications",
          collective: application]
    application [type: charm, label: "Charmed application"]   // the collective's base kind
    // -----------------------------------------------------------------------
    // Status domains — reference/status.md (values verbatim from
    // core/status/status.go + domain/status/status.go enums)
    // -----------------------------------------------------------------------
    uas_status      [type: juju-software, label: "Unit agent status\n(allocating, executing, idle,\nerror, failed, rebooting)"]
    workload_status [type: juju-software, label: "Workload status\n(active, maintenance, waiting,\nblocked, error, unknown, terminated)"]
    app_status      [type: juju-software, label: "Application status\n(leader sets; else computed\nfrom unit statuses)"]
    machine_status  [type: juju-software, label: "Machine status\n(pending, started, stopping,\nstopped, down, error)"]
    relation_status [type: juju-software, label: "Relation status\n(joining, joined, broken,\nsuspending, suspended, error)"]
    // The leader unit — application and relation status are
    // leader-gated writes (domain/status/service/leaderservice.go);
    // the leader is any unit of the application, not necessarily unit 0.
    leader          [type: charm, label: "Leader unit"]
    // -----------------------------------------------------------------------
    // Storage model records (model DB — domain/schema/model sql/0011-storage.sql)
    // -----------------------------------------------------------------------
    charm_storage_rec  [type: record, label: "charm storage\n(name, kind, count, size)",
                        ground: "model:charm_storage"]
    storage_directive_rec [type: record, label: "storage directive\n(application, pool, count, size)",
                        ground: "model:application_storage_directive"]
    storage_pool_rec   [type: record, label: "storage pool\n(name, provider type, origin)",
                        ground: "model:storage_pool"]
    storage_instance_rec [type: record, label: "storage instance\n(kind: block | filesystem, life)",
                        ground: "model:storage_instance"]
    storage_volume_rec [type: record, label: "volume\n(provider id, provision scope)",
                        ground: "model:storage_volume"]
    storage_fs_rec     [type: record, label: "filesystem\n(provider id, mount point)",
                        ground: "model:storage_filesystem"]
    storage_att_rec    [type: record, label: "storage attachment\n(instance, unit)",
                        ground: "model:storage_attachment"]

    // -----------------------------------------------------------------------
    // Network spaces records (model DB — 0008-space.sql)
    // -----------------------------------------------------------------------
    net_node_rec   [type: record, label: "net node\n(machine | unit network identity)",
                    ground: "model:net_node"]
    space_rec      [type: record, label: "space\n(name, alpha default)",
                    ground: "model:space"]
    subnet_rec     [type: record, label: "subnet\n(cidr, vlan, provider id)",
                    ground: "model:subnet"]

    // -----------------------------------------------------------------------
    // Relation databags (model DB — 0011/0023 relation tables)
    // -----------------------------------------------------------------------
    // Databag permissions (docs/reference/relation.md) — LEAN form
    // (reviewer round 20): units, not unit agents (leadership is a
    // property of the unit; the unit agent is the machinery doing the
    // API work); no model-database box — the scope chips ("model M")
    // carry the "records in the host model's database" context, and
    // the caption says it. Same-kind fan semantics: one application
    // databag per application, one unit databag per unit; each unit
    // reads + writes ONLY its own unit bag (red); the leader unit
    // also reads + writes its application's bag (red); green reads
    // everywhere else. The permission story is the same whether the
    // applications share a model or not.
    a_unit_leader [type: charm, label: "appA/leader"]
    a_unit_1      [type: charm, label: "appA/1"]
    b_unit_leader [type: charm, label: "appB/leader"]
    b_unit_1      [type: charm, label: "appB/1"]
    a_app_bag     [type: record, label: "application databag\n(app A)"]
    a_bag_a0      [type: record, label: "unit databag\n(appA/leader)"]
    a_bag_a1      [type: record, label: "unit databag\n(appA/1)"]
    b_app_bag     [type: record, label: "application databag\n(app B)"]
    b_bag_b0      [type: record, label: "unit databag\n(appB/leader)"]
    b_bag_b1      [type: record, label: "unit databag\n(appB/1)"]
    c_unit_leader [type: charm, label: "appA/leader"]
    c_unit_1      [type: charm, label: "appA/1"]
    c_app_bag     [type: record, label: "application databag\n(app A)"]
    c_bag_a0      [type: record, label: "unit databag\n(appA/leader)"]
    c_bag_a1      [type: record, label: "unit databag\n(appA/1)"]
    // -----------------------------------------------------------------------
    // Charm origin records (model DB — 0015-charm.sql: charm is
    // per-revision; channels are per-application; unit pins its own
    // charm revision)
    // -----------------------------------------------------------------------
    charm_metadata_rec [type: record, label: "charm metadata\n(name, subordinate,\nmin juju version)",
                        ground: "model:charm_metadata"]
    charm_download_rec [type: record, label: "charm download info\n(charmhub id, url, provenance)",
                        ground: "model:charm_download_info"]
    app_channel_rec    [type: record, label: "application channel\n(track, risk, branch)",
                        ground: "model:application_channel"]
    app_platform_rec   [type: record, label: "application platform\n(os, channel, architecture)",
                        ground: "model:application_platform"]

    // -----------------------------------------------------------------------
    // Operation / task / action records (model DB — 0033-operation.sql)
    // -----------------------------------------------------------------------
    operation_rec      [type: record, label: "operation\n(summary, parallel, execution group)",
                        ground: "model:operation"]
    operation_task_rec [type: record, label: "task\n(task id, enqueued/started/completed)",
                        ground: "model:operation_task"]
    operation_action_rec [type: record, label: "operation action\n(1:1 when an action; absent for exec)",
                        ground: "model:operation_action"]
    op_unit_task_rec   [type: record, label: "unit task\n(task, unit)",
                        ground: "model:operation_unit_task"]
    op_status_rec      [type: record, label: "task status\n(error, running, pending, failed,\ncancelled, completed, aborting, aborted)",
                        ground: "model:operation_task_status"]
    // -----------------------------------------------------------------------
    // Configuration levels (docs/reference/configuration.md) — where each
    // level lives and who sets it (ConfigScout grounds).
    // -----------------------------------------------------------------------
    ctrl_config_rec   [type: record, label: "controller config\n(controller DB, key/value)"]
    model_config_rec  [type: record, label: "model config\n(model DB, key/value)"]
    app_config_rec    [type: charm, label: "application config\n(model DB, per-app rows)"]

    // -----------------------------------------------------------------------
    // Hook execution participants
    // -----------------------------------------------------------------------
    apiserver  [type: juju-software, label: "API server"]

    // -----------------------------------------------------------------------
    // Deploy K8s — containeragent as the concrete unit agent on K8s
    // -----------------------------------------------------------------------
    containeragent [type: juju-software, label: "Unit agent\n(containeragent)"]

    // -----------------------------------------------------------------------
    // Integrate — two distinct unit agents
    // -----------------------------------------------------------------------
    ua1 [type: juju-software, label: "Unit agent (app A)"]
    ua2 [type: juju-software, label: "Unit agent (app B)"]
    // -----------------------------------------------------------------------
    // Secret lifecycle — actors
    // -----------------------------------------------------------------------
    observer_charm [type: charm, label: "Observer charm\n(secret consumer)"]
    secret_backend [type: external, label: "Secret content backend\n(juju database, Kubernetes, Vault)"]


    // Remove — undertaker worker
    // -----------------------------------------------------------------------
    undertaker [type: juju-software, label: "Undertaker\n(controller worker)"]
    // -----------------------------------------------------------------------
    // Machine cloud — controller machine and unit agent (both jujud)
    // -----------------------------------------------------------------------
    controller_machine [type: container, label: "Controller machine",
                        abstracts: "controller"]
    machine_agent      [type: juju-software, label: "Machine agent\n(jujud)"]

    // -----------------------------------------------------------------------
    // Machine designations (docs/reference/machine.md) — one machine
    // table, two provisioning paths: base machines by the controller
    // (its compute provisioner model worker, cmd/jujud-controller/
    // agent/model/manifolds.go:computeProvisionerName), containers by
    // the HOST machine agent (internal/worker/containerprovisioner +
    // cmd/jujud/agent/machine/manifolds.go lxdContainerProvisioner).
    // Containers are machines: each runs its own jujud machine agent,
    // which hosts the unit agent (deployer).
    // -----------------------------------------------------------------------
    machine0 [type: container, label: "Machine 0\n(cloud instance)"] {
      ma0 [type: juju-software, label: "Machine agent\n(jujud)"]
      lxd0 [type: container, label: "LXD container"] {
        ma1 [type: juju-software, label: "Machine agent\n(jujud)"]
        unit0 [type: container, label: "Unit"] {
          ua0 [type: juju-software, label: "Unit agent"]
        }
      }
    }

    // -----------------------------------------------------------------------
    // Worker tree — the controller dependency engine
    // (cmd/jujud-controller/agent/{machine,model}/manifolds.go)
    // -----------------------------------------------------------------------
    agent_worker [type: juju-software, label: "Agent\n(config)",
                  ground: "cmd/jujud-controller/agent/machine/manifolds.go:agentName"]
    db_accessor [type: juju-software, label: "DB accessor\n(runs local Dqlite)",
                 ground: "cmd/jujud-controller/agent/machine/manifolds.go:dbAccessorName"]
    change_stream [type: juju-software, label: "Change stream",
                   ground: "cmd/jujud-controller/agent/machine/manifolds.go:changeStreamName"]
    domain_services [type: juju-software, label: "Domain services\n(controller + model)",
                     ground: "cmd/jujud-controller/agent/machine/manifolds.go:domainServicesName"]
    provider_services [type: juju-software, label: "Provider services",
                       ground: "cmd/jujud-controller/agent/machine/manifolds.go:providerDomainServicesName"]
    provider_tracker [type: juju-software, label: "Provider tracker\n(cloud handles)",
                      ground: "cmd/jujud-controller/agent/machine/manifolds.go:providerTrackerName"]
    lease_manager [type: juju-software, label: "Lease manager",
                   ground: "cmd/jujud-controller/agent/machine/manifolds.go:leaseManagerName"]
    primary_flag [type: juju-software, label: "Primary election\n(lease flag)",
                  ground: "cmd/jujud-controller/agent/machine/manifolds.go:isPrimaryControllerFlagName"]
    lease_expiry [type: juju-software, label: "Lease expiry\n(primary only)",
                  ground: "cmd/jujud-controller/agent/machine/manifolds.go:leaseExpiryName"]
    object_store [type: juju-software, label: "Object store\n(blob store)",
                  ground: "cmd/jujud-controller/agent/machine/manifolds.go:objectStoreName"]
    api_server [type: juju-software, label: "API server\n(facades)",
                ground: "cmd/jujud-controller/agent/machine/manifolds.go:apiServerName"]
    http_server [type: juju-software, label: "HTTP server\n(TLS mux)",
                 ground: "cmd/jujud-controller/agent/machine/manifolds.go:httpServerName"]
    model_worker_manager [type: juju-software, label: "Model worker manager\n(per-model runners)",
                          ground: "cmd/jujud-controller/agent/machine/manifolds.go:modelWorkerManagerName"]
    provisioner [type: juju-software, label: "Compute provisioner\n(model worker)",
                 ground: "cmd/jujud-controller/agent/model/manifolds.go:computeProvisionerName"]

    // -----------------------------------------------------------------------
    // Data model — Dqlite record nodes (model database)
    // -----------------------------------------------------------------------
    application_rec [type: record, label: "application\n(name, charm ref, config)",
                     ground: "model:application"]
    unit_rec        [type: record, label: "unit\n(application, charm rev, lifecycle)",
                     ground: "model:unit"]
    machine_rec     [type: record, label: "machine / pod\n(constraints, provider ID)",
                     ground: "model:machine"]
    charm_rec       [type: record, label: "charm\n(source, revision, archive)",
                     ground: "model:charm"]
    relation_rec    [type: record, label: "relation\n(endpoints, data bags)",
                     ground: "model:relation"]

    // Controller database records — provenance spine (controller DB).
    // The walk unit → application → model → cloud crosses both databases.
    user_rec        [type: record, label: "user\n(name, access levels)",
                     ground: "controller:user"]
    cloud_rec       [type: record, label: "cloud\n(endpoint, regions, CA)",
                     ground: "controller:cloud"]
    credential_rec  [type: record, label: "cloud credential\n(auth attributes)",
                     ground: "controller:cloud_credential"]
    model_rec       [type: record, label: "model\n(cloud, credential, namespace)",
                     ground: "controller:model"]
    controller_rec  [type: record, label: "controller\n(identity, HA nodes)",
                     ground: "controller:controller"]
    // Relation endpoints (model DB) — the indirection through which
    // a relation connects two applications. DECLARED FLATTENING: one
    // node covers two real tables (application_endpoint + relation_endpoint).
    endpoint_rec     [type: record, label: "endpoint\n(application, relation, role)",
                      ground: "model:application_endpoint+relation_endpoint"]

    // -----------------------------------------------------------------------
    // Cross-model integration records (offers live in the offering model
    // DB; the external controller reference lives in the consuming
    // controller DB)
    // -----------------------------------------------------------------------
    offer_rec               [type: record, label: "offer\n(published endpoints)",
                             ground: "model:offer"]
    offer_connection_rec    [type: record, label: "offer connection\n(consumer link)",
                             ground: "model:offer_connection"]
    remote_app_rec         [type: record, label: "remote application\n(proxy of offerer)",
                            ground: "model:application_remote_offerer"]
    external_controller_rec [type: record, label: "external controller\n(API addresses, CA)",
                             ground: "controller:external_controller"]

    // -----------------------------------------------------------------------
    // Uniter — the unit agent's hook execution engine, plus the states
    // of its three-phase operation executor (prepare → execute → commit)
    // -----------------------------------------------------------------------
    uniter [type: juju-software, label: "Uniter\n(hook execution engine)",
            ground: "internal/worker/uniter/manifold.go:NewOperationExecutor"]
    // Executor states: the labels are the verbatim strings from
    // internal/worker/uniter/operation/executor.go:28-30
    // (stepPrepare / stepExecute / stepCommit); guards: ErrHookFailed,
    // ErrNeedsReboot in operation/errors.go.
    uop_idle       [type: juju-software, label: "idle"]
    uop_preparing  [type: juju-software, label: "preparing"]
    uop_executing  [type: juju-software, label: "executing"]
    uop_committing [type: juju-software, label: "committing"]
    uop_error      [type: juju-software, label: "error"]
    sec_reserved  [type: juju-software, label: "reserved"]
    sec_active    [type: juju-software, label: "active (latest revision)"]
    sec_rotate    [type: juju-software, label: "rotate due"]
    sec_expired   [type: juju-software, label: "expiry due"]
    sec_obsolete  [type: juju-software, label: "obsolete (pending delete)"]
    sec_removed   [type: juju-software, label: "removed"]

    // -----------------------------------------------------------------------
    // Intro-view archetypes — real types rendered as N labelled instances
    // per view (instances: notation, ggarch 0.22.0). The instances are
    // illustrations; the types and their edges are the product's actual
    // structure. Used by the intro views below:
    //   bare_application — pre-Juju workload (external, no Juju records)
    //   cloud            — the generic cloud node for machine sequences
    //   apps             — charmed application
    //   unit_pod         — the unit: agent + charm + workload (K8s truth)
    // -----------------------------------------------------------------------
    bare_application [type: external, label: "application"]

    // -----------------------------------------------------------------------
    // HA controller — the controller node archetype, instanced per view.
    // The mesh edge (in the edges block) is the truth the old ring
    // approximated: Raft replication is full-mesh — the leader
    // replicates to all peers; every node talks to every other.
    // -----------------------------------------------------------------------
    controller_node [type: container, label: "controller node"] {
      ha_agent  [type: juju-software,
             label: "controller agent\n(jujud, embedded Dqlite)"]
    }
  }

  edges {
    // Parked observations (map-to-meaning audit, 2026-09-21) - things
    // we are NOT drawing or rewording now, but might reconsider:
    // 1. The pebble-notices channel is real and undrawn: pebble
    //    notices reach the charm via the unit agent's pebblepoller/
    //    pebblenotices workers (internal/worker/uniter/pebblepoller.
    //    go) - pebble -> unit_agent -> charm.
    // 2. The abstract controller -> charmhub edge could read
    //    "downloads charm archives to its object store" - unit agents
    //    never fetch from Charmhub; the controller fetches, stores the
    //    blob, and serves the archive (apiserver object handlers).
    // 3. The LXD container provisioner runs on the HOST machine agent
    //    (internal/worker/containerprovisioner), not the controller -
    //    the "clouds" edges cover machine instances only.
    // 4. Unit agents never see Charmhub - they pull the archive from
    //    the controller (UniterAPI.CharmArchiveSha256 + the object-
    //    store GET); worth an edge if a view ever tells that story.
    // Intent chain
    user   -> client     [type: control, label: "sends commands to"]
    client -> controller [type: api,     label: "calls Juju API on"]
    agents -> controller [type: stream, label: "watches for changes on"]
    agents -> world      [type: control, label: "reconciles"]
    agents -> apps       [type: control, label: "reconciles"]

    // Controller to clouds and charmhub
    controller -> clouds   [type: control, label: "gets nodes from"]
    controller -> charmhub [type: api,     label: "fetches charms from"]

    // K8s topology
    jujud          -> k8s            [type: control, label: "provisions on"]
    unit_agent -> jujud  [type: api,    label: "makes API calls to"]
    jujud          -> charmhub       [type: api,     label: "fetches charms"]
    charm          -> pebble         [type: api,     label: "calls Pebble API"]
    pebble         -> workload       [type: control, label: "supervises"]

    // Hook execution
    apiserver  -> unit_agent [type: stream,  label: "watcher"]
    unit_agent -> charm      [type: control, label: "executes hooks from"]
    charm      -> unit_agent [type: ipc,     label: "calls hook command on"]
    unit_agent -> apiserver  [type: api,     label: "flushes hook changes to"]

    // Status domains (reference/status.md) — who sets what. Each of the
    // five status domains has one owning writer. Relation status is
    // leader-gated in 4.0 (the controller firewaller's SetRelationStatus
    // is NotImplemented — cross-model relations are disabled).
    unit_agent    -> uas_status      [type: control, label: "sets",
                          ground: "internal/worker/uniter/agent.go:setAgentStatus"]
    charm         -> workload_status [type: control, label: "sets (status-set)",
                          ground: "internal/worker/uniter/runner/jujuc/status-set.go:NewStatusSetCommand"]
    leader        -> app_status      [type: control, label: "sets (status-set)",
                          ground: "domain/status/service/leaderservice.go:SetApplicationStatusForUnitLeader"]
    leader        -> relation_status [type: control, label: "sets",
                          ground: "domain/status/service/leaderservice.go:SetRelationStatus"]
    machine_agent -> machine_status  [type: control, label: "sets",
                          ground: "api/agent/provisioner/machine.go:SetStatus"]

    // Machine designations (docs/reference/machine.md — MachineScout
    // grounds): the host machine agent watches its containers
    // (machine.WatchContainers) and provisions them through the LXD
    // broker; unit placement hangs off the shared net_node
    // (domain/application/state/machine_placement.go:144-147).
    controller -> machine0 [type: control, label: "provisions\n(StartInstance)",
                          ground: "cmd/jujud-controller/agent/model/manifolds.go:computeProvisionerName"]
    ma0 -> controller     [type: api,     label: "watches containers on\n(WatchContainers)"]
    ma0 -> lxd0           [type: control, label: "provisions container\n(LXD broker)"]
    ma1 -> ua0            [type: control, label: "hosts (deployer)"]

    // Configuration levels (docs/reference/configuration.md —
    // ConfigScout grounds): who sets and reads each level.
    // juju controller-config (cmd/juju/controller/config.go),
    // juju model-config (cmd/juju/model/config.go), juju config
    // (cmd/juju/application/config.go), config-get (the hook tool;
    // there is NO config-set hook command), and the controller's own
    // config table (domain/schema/controller/4.0.13-controller-
    // release.ddl:571).
    user       -> ctrl_config_rec  [type: control, label: "sets\n(juju controller-config)",
                            ground: "cmd/juju/controller/config.go:NewConfigCommand"]
    user       -> model_config_rec [type: control, label: "sets\n(juju model-config)",
                            ground: "cmd/juju/model/config.go:configCommand"]
    user       -> app_config_rec   [type: control, label: "sets\n(juju config)",
                            ground: "cmd/juju/application/config.go:NewConfigCommand"]
    charm      -> app_config_rec   [type: api, label: "reads\n(config-get)",
                            ground: "internal/worker/uniter/runner/jujuc/config-get.go:NewConfigGetCommand"]
    controller -> ctrl_config_rec  [type: data, label: "keeps\n(controller DB)",
                            ground: "controller:controller_config"]

    // Bootstrap K8s
    client         -> k8s            [type: api]
    k8s            -> client         [type: stream]
    client         -> controller_pod [type: api, label: "polls the API until ready"]
    // Deploy K8s
    controller     -> k8s              [type: control, label: "creates unit pods on"]
    controller     -> containeragent   [type: control, label: "starts via the k8s pod spec"]
    containeragent -> controller       [type: api, label: "makes API calls to"]

    // Bootstrap machine
    client             -> controller_machine  [type: control, label: "ssh-installs the controller agent on"]
    client             -> controller_machine  [type: api, label: "polls the API until initialised"]

    // Deploy machine
    controller    -> machine_agent  [type: control, label: "provisions with user data, serves agent binaries"]
    machine_agent -> controller     [type: api, label: "makes API calls to"]

    // Machine/unit removal and bootstrap machine — generic cloud
    client     -> cloud  [type: api]
    controller -> cloud  [type: control, label: "provisions on"]
    cloud      -> controller [type: control]
    cloud      -> client     [type: api]

    // Integrate
    ua1 -> controller [type: stream]
    ua2 -> controller [type: stream]
    ua1        -> controller [type: api]
    ua2        -> controller [type: api]

    // Remove / destroy — user sends directly to controller
    user           -> controller  [type: event]
    unit_agent -> controller [type: stream, label: "watches for\nchanges on"]
    unit_agent     -> controller  [type: api, label: "makes API calls to"]
    // Model removal
    controller -> undertaker [type: stream, label: "model removal events"]
    undertaker -> controller [type: control, label: "purges dead models and their databases from"]

    // Schema associations — semantic direction, multiplicity in the
    // label (on the many end) until crow's-foot glyphs land (SPEC Phase 9).
    // ground: = the FK (or table) that realizes the association.
    // DROPPED from juju2: cloud -> controller "hosts" — no verifiable
    // FK in the new controller DDL (controller table has model_uuid,
    // not cloud_uuid). Legacy-ER claim; re-add only when grounded.
    // The controller hosts its models by database containment (one
    // controller database per controller; database.md): the DDL FK is
    // the controller row's model_uuid — the controller model. The
    // 0..N claim is the containment story, curating that FK.
    controller_rec   -> model_rec      [type: data, label: "hosts 0..N",
                                        ground: "controller:controller.model_uuid"]
    // Controller database
    user_rec        -> cloud_rec       [type: data, label: "accesses 0..N",
                                        ground: "controller:permission_object_access"]
    user_rec        -> credential_rec [type: data, label: "owns 0..N",
                                        ground: "controller:cloud_credential.owner_uuid"]
    cloud_rec       -> credential_rec [type: data, label: "defines 0..N",
                                        ground: "controller:cloud_credential.cloud_uuid"]
    model_rec       -> cloud_rec      [type: data, label: "deployed on (one)",
                                        ground: "controller:model.cloud_uuid"]
    model_rec       -> credential_rec [type: data, label: "uses 0..1",
                                        ground: "controller:model.cloud_credential_uuid"]
    // Storage model (0011-storage.sql)
    charm_storage_rec  -> storage_directive_rec [type: data, label: "fulfilled by 1..N",
                          ground: "model:application_storage_directive.storage_name"]
    storage_directive_rec -> storage_pool_rec [type: data, label: "pins (one)",
                          ground: "model:application_storage_directive.storage_pool_uuid"]
    storage_instance_rec -> storage_pool_rec [type: data, label: "provisioned from (one)",
                          ground: "model:storage_instance.storage_pool_uuid"]
    storage_instance_rec -> storage_volume_rec [type: data, label: "backed by (one)",
                          ground: "model:storage_instance_volume.storage_volume_uuid"]
    storage_instance_rec -> storage_fs_rec [type: data, label: "backed by (one)",
                          ground: "model:storage_instance_filesystem.storage_filesystem_uuid"]
    storage_att_rec    -> storage_instance_rec [type: data, label: "attaches 1..1",
                          ground: "model:storage_attachment.storage_instance_uuid"]
    storage_volume_rec -> net_node_rec [type: data, label: "attached to 0..1",
                          ground: "model:storage_volume_attachment.net_node_uuid"]
    // Network spaces (0008-space.sql)
    subnet_rec        -> space_rec    [type: data, label: "belongs to 0..1",
                          ground: "model:subnet.space_uuid"]
    application_rec   -> space_rec    [type: data, label: "default binding (one)",
                          ground: "model:application.space_uuid"]
    // PARKED rendering notes (sequence + fan work, reviewer rounds
    // 20-23, recorded in ggarch TODOS.md):
    // 1. Sequence BLOCK_PAD 8 -> ~24: the loop/alt borders cut
    //    through first-inner-step labels and the alt bottom lands
    //    flush on the repeated footer boxes.
    // 2. Sequences ignore the topology edge-type vocabulary —
    //    verified to match Mermaid/UML (dashed = return); if a
    //    sequence ever needs channel types, a colour accent layers
    //    on without touching the dashed-returns convention.
    // 3. Machine designations: far-end port symmetry for the
    //    through-pair (controller<->ma0) — the strokes converge at
    //    the far ends and re-bow; label_side machinery is in
    //    (ggarch c289732), far-end pairing is the remaining step.
    // Relation databags (domain/relation) — the permission law is
    // reference/relation.md: each unit reads + writes its OWN unit
    // bag; the LEADER unit also reads + writes its application's
    // application bag (writes leader-gated); ALL units — leaders
    // included — read ALL of the REMOTE application's databags
    // (GetRelationUnitSettings / GetRelationApplicationSettings). A
    // unit does NOT read its own application's other unit bags (in
    // the regular case nothing turns inwards). Peer case: everything
    // turns inwards — every unit reads every bag of its OWN
    // application, the application databag included (the uniter's
    // watcher watches the own endpoint's app settings and all peers,
    // related_unit_watcher.go:InitialWatchRelatedUnits).
    // Panel A (app A units): own bags rw; leader rw own app bag;
    // ALL units read ALL remote (app B) bags.
    a_unit_leader -> a_bag_a0    [type: read_write, label: "reads + writes",
                          ground: "model:relation_unit_setting"]
    a_unit_1      -> a_bag_a1    [type: read_write, label: "reads + writes",
                          ground: "model:relation_unit_setting"]
    a_unit_leader -> a_app_bag   [type: read_write, label: "reads + writes",
                          ground: "model:relation_application_setting"]
    a_unit_1      -> b_app_bag   [type: read_only, label: "reads",
                          ground: "domain/relation/service/relation.go:GetRelationApplicationSettings"]
    a_unit_1      -> b_bag_b0    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    a_unit_1      -> b_bag_b1    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    a_unit_leader -> b_app_bag   [type: read_only, label: "reads",
                          ground: "domain/relation/service/relation.go:GetRelationApplicationSettings"]
    a_unit_leader -> b_bag_b0    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    a_unit_leader -> b_bag_b1    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    // Panel B (app B units): the mirror.
    b_unit_leader -> b_bag_b0    [type: read_write, label: "reads + writes",
                          ground: "model:relation_unit_setting"]
    b_unit_1      -> b_bag_b1    [type: read_write, label: "reads + writes",
                          ground: "model:relation_unit_setting"]
    b_unit_leader -> b_app_bag   [type: read_write, label: "reads + writes",
                          ground: "model:relation_application_setting"]
    b_unit_1      -> a_app_bag   [type: read_only, label: "reads",
                          ground: "domain/relation/service/relation.go:GetRelationApplicationSettings"]
    b_unit_1      -> a_bag_a0    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    b_unit_1      -> a_bag_a1    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    b_unit_leader -> a_app_bag   [type: read_only, label: "reads",
                          ground: "domain/relation/service/relation.go:GetRelationApplicationSettings"]
    b_unit_leader -> a_bag_a0    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    b_unit_leader -> a_bag_a1    [type: read_only, label: "reads",
                          ground: "model:relation_unit_setting"]
    // Panel C (peer relation): everything turns inwards — every unit
    // reads every bag of its own application, application bag included.
    c_unit_leader -> c_bag_a0    [type: read_write, label: "reads + writes",
                          ground: "model:relation_unit_setting"]
    c_unit_1      -> c_bag_a1    [type: read_write, label: "reads + writes",
                          ground: "model:relation_unit_setting"]
    c_unit_leader -> c_app_bag   [type: read_write, label: "reads + writes",
                          ground: "model:relation_application_setting"]
    c_unit_1      -> c_app_bag   [type: read_only, label: "reads",
                          ground: "domain/relation/state/related_unit_watcher.go:InitialWatchRelatedUnits"]
    c_unit_1      -> c_bag_a0    [type: read_only, label: "reads",
                          ground: "domain/relation/state/related_unit_watcher.go:InitialWatchRelatedUnits"]

    // Charm origin (0015-charm.sql + 0019-application.sql)
    charm_metadata_rec -> charm_rec [type: data, label: "describes (one)",
                          ground: "model:charm_metadata.charm_uuid"]
    charm_download_rec -> charm_rec [type: data, label: "downloaded via 0..1",
                          ground: "model:charm_download_info.charm_uuid"]
    application_rec    -> app_channel_rec [type: data, label: "tracks 0..1",
                          ground: "model:application_channel.application_uuid"]
    application_rec    -> app_platform_rec [type: data, label: "pinned platform (one)",
                          ground: "model:application_platform.application_uuid"]
    // Operation / task / action (0033-operation.sql)
    operation_task_rec -> operation_rec [type: data, label: "groups 1..N",
                          ground: "model:operation_task.operation_uuid"]
    operation_action_rec -> operation_rec [type: data, label: "marks the action (1:1)",
                          ground: "model:operation_action.operation_uuid"]
    op_unit_task_rec -> operation_task_rec [type: data, label: "the task (one)",
                          ground: "model:operation_unit_task.task_uuid"]
    op_unit_task_rec -> unit_rec       [type: data, label: "runs on (one unit)",
                          ground: "model:operation_unit_task.unit_uuid"]
    op_status_rec     -> operation_task_rec [type: data, label: "reports 0..1",
                          ground: "model:operation_task_status.task_uuid"]
    // Model database
    // (model membership is by database — implicit, no FK; table-level ground)
    model_rec       -> application_rec [type: data, label: "contains 0..N",
                                        ground: "model:application"]
    application_rec -> charm_rec       [type: data, label: "uses (one)",
                                        ground: "model:application.charm_uuid"]
    application_rec -> unit_rec        [type: data, label: "has 1..N",
                                        ground: "model:unit.application_uuid"]
    // Placement: unit and machine share a net node
    // (unit.net_node_uuid, machine.net_node_uuid) — "runs on" is
    // realized by that shared node, not a direct FK.
    unit_rec        -> machine_rec     [type: data, label: "runs on (one)",
                                        ground: "model:net_node"]
    relation_rec    -> endpoint_rec    [type: data, label: "has 2 (one per side)",
                                        ground: "model:relation_endpoint.relation_uuid"]
    endpoint_rec    -> application_rec [type: data, label: "belongs to (one)",
                                        ground: "model:application_endpoint.application_uuid"]

    // Cross-model integration associations
    application_rec -> offer_rec                [type: data, label: "publishes 0..N",
                                                  ground: "model:offer"]
    offer_rec        -> offer_connection_rec    [type: data, label: "has 0..N",
                                                  ground: "model:offer_connection"]
    model_rec        -> external_controller_rec [type: data, label: "may reference 0..N",
                                                  ground: "controller:external_controller"]
    remote_app_rec   -> relation_rec            [type: data, label: "participates in 0..N",
                                                  ground: "model:application_remote_offerer"]

    // Intro views — archetype edges; instances fan from these per view.
    // All technically true: the user operates pre-Juju applications
    // directly; applications converge toward the controller's recorded
    // goal state (reconciliation); the unit agent watches the controller
    // for changes.
    user       -> bare_application [type: control, label: "operates"]
    apps       -> controller       [type: control, label: "watch for changes on"]
    // The base-kind twin of the collective edge: "Intro: Juju enters"
    // individuates the applications (instances of `application`), and
    // the star expansion pairs on the archetype the instances come
    // from — this edge is the one that fans per copy there.
    application -> controller      [type: control, label: "watch for changes on"]

    // HA controller — Raft sync between Dqlite nodes: full mesh
    // (pairing: mesh — every distinct pair, never a node with itself)
    ha_agent -> ha_agent [type: stream, label: "Raft sync", pairing: mesh,
                                arrow: both,
                                ground: "domain/controllernode/state/state.go:AddDqliteNode"]

    // Worker tree — the machine-cloud execution chain
    machine_agent -> unit_agent [type: control, label: "hosts (nested)"]
    unit_agent    -> uniter     [type: control, label: "runs hooks via"]
    uniter        -> charm      [type: control, label: "dispatches"]


    // Worker tree — the controller dependency engine. Edge direction is
    // consumer -> provider: the source worker depends on the capability
    // the target provides (dependency.Manifolds Inputs).
    agent_worker     -> db_accessor     [type: control, label: "provides the agent config and its change notifications"]
    change_stream   -> db_accessor     [type: stream,  label: "watches the database"]
    domain_services -> db_accessor     [type: control, label: "reads the dqlite cluster description from"]
    domain_services -> change_stream    [type: control, label: "creates change watchers over"]
    lease_manager   -> db_accessor     [type: control, label: "stores its leases"]
    primary_flag    -> lease_manager   [type: control, label: "claims the controller-ownership lease"]
    lease_expiry    -> primary_flag    [type: control, label: "runs only when primary"]
    object_store    -> lease_manager   [type: control, label: "guards access by lease"]
    api_server      -> domain_services [type: control, label: "exposes domain services"]
    api_server      -> object_store    [type: control, label: "stores and serves blobs"]
    http_server     -> api_server      [type: control, label: "serves the shared mux for"]
    provider_services -> change_stream [type: control, label: "late-binds per-model provider services via"]
    provider_tracker  -> provider_services [type: control, label: "fetches cloud handles"]
    undertaker      -> domain_services [type: control, label: "tears models down"]
    model_worker_manager -> domain_services    [type: control, label: "watches activated models to start workers"]
    model_worker_manager -> provider_services  [type: control, label: "gets provider factories"]
    provisioner     -> model_worker_manager [type: control, label: "runs as a model worker"]

    // Uniter operation executor — transitions
    uop_idle       -> uop_preparing  [type: control]
    uop_preparing  -> uop_executing  [type: control]
    uop_executing  -> uop_committing [type: control]
    uop_executing  -> uop_error      [type: control]
    uop_error      -> uop_idle      [type: control]
    sec_reserved   -> sec_active        [type: control]
    sec_active     -> sec_rotate        [type: control]
    sec_rotate     -> sec_active        [type: control]
    sec_active     -> sec_expired       [type: control]
    sec_expired    -> sec_removed       [type: control]
    sec_active     -> sec_removed       [type: control]
    uop_committing -> uop_idle       [type: control]
  }

  behaviours {

    behaviour "Hook execution" {
      apiserver -> unit_agent: async "watcher fires"
      unit_agent -> unit_agent: self "snapshot remote state"
      unit_agent -> unit_agent: self "resolve next hook"
      unit_agent -> charm: call "exec dispatch"
      loop "during hook" {
        charm -> unit_agent: call "hook command"
        unit_agent -> apiserver: call "serve via API"
        apiserver -> unit_agent: return "response"
        unit_agent -> charm: return "exit code"
      }
      alt "exit 0" {
        charm -> unit_agent: return "success"
        unit_agent -> apiserver: call "flush writes"
      } else "failure" {
        charm -> unit_agent: return "failure"
        unit_agent -> apiserver: call "discard writes, unit error"
      }
    }

    behaviour "Bootstrap K8s" {
      user           -> client:          call "juju bootstrap"
      client         -> k8s:             call "Authenticate"
      k8s            -> client:          return "OK"
      client         -> k8s:             call "Create namespace + deploy controller pod"
      k8s            -> client:          return "Pod scheduled"
      controller_pod -> controller_pod:  self "Start jujud"
      controller_pod -> controller_pod:  self "Start API server"
      controller_pod -> controller_pod:  self "Initialise database"
      controller_pod -> client:          return "API ready"
      client         -> user:            return "Bootstrap complete"
    }

    behaviour "Deploy K8s" {
      user           -> client:          call "juju deploy"
      client         -> controller:      call "Deploy RPC call"
      controller     -> controller:      self "Write application + unit records"
      controller     -> k8s:             call "Schedule unit pod"
      k8s            -> controller:      return "Pod running"
      controller     -> containeragent:  call "Start containeragent"
      containeragent -> controller:      call "install hook"
      containeragent -> controller:      call "config-changed hook"
      containeragent -> controller:      call "start hook"
      containeragent -> controller:      return "unit active"
      controller     -> client:          return "deploy complete"
      client         -> user:            return "Application deployed"
    }

    behaviour "Integrate" {
      user       -> client:      call "juju integrate A B"
      client     -> controller:  call "Integrate RPC call"
      controller -> controller:  self "Write relation record"
      controller -> ua1:         async "watcher fires"
      controller -> ua2:         async "watcher fires"
      ua1        -> controller:  call "relation-created hook"
      ua2        -> controller:  call "relation-created hook"
      ua1        -> controller:  call "relation-joined hook"
      ua2        -> controller:  call "relation-joined hook"
      ua1        -> controller:  call "relation-changed hook"
      ua2        -> controller:  call "relation-changed hook"
      ua1        -> controller:  call "Write relation data (app A)"
      controller -> ua2:         async "watcher fires (data changed)"
      ua2        -> controller:  call "relation-changed hook"
      ua2        -> controller:  call "Write relation data (app B)"
      controller -> ua1:         async "watcher fires (data changed)"
      ua1        -> controller:  call "relation-changed hook"
    }

    behaviour "Unit removal" {
      user       -> controller:  call "juju remove-unit"
      controller -> controller:  self "Mark unit Dying"
      controller -> unit_agent:  async "watcher fires"
      unit_agent -> controller:  call "stop hook"
      unit_agent -> controller:  call "teardown hooks"
      unit_agent -> controller:  call "remove hook"
      unit_agent -> controller:  call "Mark unit Dead"
      controller -> cloud:       call "Release machine"
      controller -> controller:  self "Delete unit records"
    }

    behaviour "Model removal" {
      user       -> controller:  call "juju destroy-model"
      controller -> controller:  self "Mark model Dying"
      controller -> undertaker:  async "watcher fires"
      undertaker -> controller:  call "Destroy all applications"
      controller -> cloud:       call "Release all machines"
      controller -> controller:  self "Mark model Dead"
      undertaker -> controller:  call "Delete model records"
      undertaker -> controller:  call "Delete model Dqlite database"
    }

    behaviour "Bootstrap machine" {
      user               -> client:             call "juju bootstrap"
      client             -> cloud:              call "Authenticate"
      cloud              -> client:             return "OK"
      client             -> cloud:              call "Provision VM"
      cloud              -> client:             return "VM ready"
      client             -> controller_machine: call "Install jujud + seed config"
      controller_machine -> controller_machine: self "Start controller agent"
      controller_machine -> controller_machine: self "Start API server + database"
      controller_machine -> client:             return "API ready"
      client             -> user:               return "Bootstrap complete"
    }

    behaviour "Deploy machine" {
      user          -> client:        call "juju deploy"
      client        -> controller:    call "Deploy RPC call"
      controller    -> controller:    self "Write application + unit records"
      controller    -> cloud:         call "Provision machine"
      cloud         -> controller:    return "Machine ready"
      controller    -> machine_agent: call "Start jujud"
      machine_agent -> controller:    call "install hook"
      machine_agent -> controller:    call "config-changed hook"
      machine_agent -> controller:    call "start hook"
      machine_agent -> controller:    return "unit active"
      controller    -> client:        return "deploy complete"
      client        -> user:          return "Application deployed"
    }



    behaviour "juju status" {
      user        -> client:     call "juju status"
      client      -> controller: call "Status API call"
      controller  -> controller: self "read status records"
      controller  -> controller: self "derive agent liveness (live connection state)"
      controller  -> client:     return "projected status"
      client      -> user:       return "status output"
    }

    behaviour "Uniter operation" {
      uop_idle        -> uop_preparing:  call "resolve hook"       [on: "hook queued"]
      uop_preparing   -> uop_executing:  call "snapshot + run"
      uop_executing   -> uop_committing: return "exit 0"           [guard: "hook exits 0"]
      uop_executing   -> uop_error:     async "fail"               [guard: "hook fails"]
      uop_error       -> uop_idle:      return "retry / escalate" [on: "retry"]
      uop_committing  -> uop_idle:      return "commit state"     [on: "write complete"]
    }

behaviour "Secret lifecycle" {
      sec_reserved  -> sec_active:        call "create"               [on: "secret-add | add-secret"]
      sec_active    -> sec_active:        self "grant / revoke"       [on: "secret-grant | grant-secret"]
      sec_active    -> sec_active:        self "publish new revision" [on: "secret-set | update-secret"]
      sec_active    -> sec_rotate:    async "rotate due"          [guard: "rotate policy"]
      sec_rotate -> sec_active:       call "new revision"         [on: "secret-rotate (leader)"]
      sec_active    -> sec_expired:       async "expiry due"          [guard: "revision expiry"]
      sec_expired   -> sec_removed:       call "retire revision"      [on: "secret-expired -> secret-remove"]
      sec_active    -> sec_removed:      async "no consumer tracks it" [on: "revision superseded"]
      sec_active -> sec_removed:       call "prune"                [on: "secret-remove | auto-prune"]
      sec_active    -> sec_active:        self "notify consumers"     [on: "secret-changed"]
    }

    behaviour "Action run flow" {
      user        -> client:     call "juju run <action> key=v"
      client      -> controller: call "enqueue operation"
      controller  -> controller: self "operation + per-unit tasks (pending)"
      controller  -> unit_agent: async "watcher fires"
      unit_agent  -> unit_agent: self "resolve next action"
      unit_agent  -> controller: call "start task (pending -> running)"
      unit_agent  -> charm:      call "run action (dispatch)"
      loop "during action" {
        charm     -> unit_agent: call "action-get / action-set / action-fail / action-log"
      }
      alt "cancel-task" {
        controller -> unit_agent: async "aborting"
        unit_agent -> unit_agent: self "kill charm process"
        charm      -> unit_agent: return "aborted"
      } else "runs to completion" {
        charm      -> unit_agent: return "results (return-code, stdout, stderr)"
      }
      unit_agent  -> controller: call "finish task (completed | failed | aborted; results to object store)"
      client      -> controller: call "poll results (GetActionResult)"
      controller  -> client:     return "results"
    }

    behaviour "Bundle deploy" {
      user            -> client:     call "juju deploy <bundle> --overlay"
      client          -> client:     self "merge overlay into base bundle"
      client          -> controller: call "model status snapshot"
      client          -> client:     self "build change graph (toposort)"
      client          -> controller: call "apply changes in order"
      controller      -> controller: self "deploy, add-machine, add-relation, add-unit, expose, set-options"
      client          -> controller: call "create / consume offers"
    }

    behaviour "Web CLI" {
      charm           -> charm:      self "serve /commands websocket"
      charm           -> charm:      self "whitelist filter (plugins, upgrade-controller excluded)"
      charm           -> charm:      self "run embedded juju CLI in-process"
      charm           -> charm:      async "stream CLICommandStatus lines"
    }

    behaviour "Log flow" {
      unit_agent    -> unit_agent:    self "buffer log records"
      machine_agent -> machine_agent: self "buffer log records"
      unit_agent    -> controller:    call "ship logs (/logsink websocket)"
      machine_agent -> controller:    call "ship logs (/logsink websocket)"
      controller    -> controller:    self "batch JSON lines to logsink.log"
      user          -> client:        call "juju debug-log"
      client        -> controller:    call "tail logsink.log (Log API)"
      controller    -> client:        return "log records"
    }

    // Reference + tutorial: the verification story behind the
    // tutorial's "Handle authentication and authorization" — grounded
    // in cmd/juju/user/whoami.go (local client-store read, no API
    // call), cmd/juju/user/info.go + the UserManager facade
    // (apiserver/facades/client/usermanager), and
    // environs/bootstrap/prepare.go (bootstrap caches the admin
    // account client-side; agent/agentbootstrap creates it with
    // superuser access server-side).
    behaviour "User authentication" {
      user          -> client:     call "juju whoami"
      client        -> client:     self "read admin account (cached at bootstrap)"
      user          -> client:     call "juju show-user admin"
      client        -> controller: call "UserManager.UserInfo"
      controller    -> client:     return "user info (access: superuser)"
    }

  }

  style {
    extends: juju
    // Databag permission semantics (reviewer round 16, the
    // excalidraw's red/green): read&write vs read-only.
    edge read_write { stroke: "#C0392B" }
    edge read_only  { stroke: "#1E8449" }
  }

}

// ==========================================================================
// Views
// ==========================================================================

// --------------------------------------------------------------------------
// Insight: overview with intent/execution chain
// --------------------------------------------------------------------------

diagram "Juju overview" from "Juju" {
  select { nodes: user client controller apps clouds charmhub
           edges: type control type api type stream }
  positions {
    user       left-of client
    user       align-middle client
    client     left-of controller
    client     align-middle controller
    apps       right-of controller
    apps       align-middle controller
    clouds     above controller    gap: 40
    clouds     align-centre controller
    charmhub   below controller    gap: 40
    charmhub   align-centre controller
  }
  annotations {
    legend [position: "bottom-right",
            person: "operator",
            juju-software: "Juju process",
            external: "cloud / external",
            charm: "charm",
            control: "manages / drives",
            api: "API call",
            stream: "watch (async)"]
  }
}

// --------------------------------------------------------------------------
// Topology: K8s deployment
// --------------------------------------------------------------------------

diagram "K8s deployment topology" from "Juju" {
  select {
    nodes: k8s controller_pod unit_pod charmhub
    edges: type api type control
  }
  positions {
    controller_pod left-of unit_pod      gap: 60
    controller_pod align-middle unit_pod
    k8s            above controller_pod  gap: 40
    k8s            align-centre controller_pod
    charmhub       below controller_pod  gap: 80
    charmhub       align-centre jujud
    jujud          align-middle unit_agent
    unit_pod       direction: right
    charm_container    same-width workload_container
    unit_agent         same-width charm
    pebble             same-width workload
    jujud              min-width: 160
    charm_container    left-of workload_container  gap: 80
  }
  annotations {
    legend [position: "bottom-right",
