        value [label: "value", type: "text"]
      }
    }

    model [type: record, label: "Model",
                 ground: "controller:model"] {
      fields {
        uuid [label: "uuid", type: "text", pk: true]
        activated [label: "activated", type: "bool"]
        cloud_uuid [label: "cloud_uuid", type: "text", fk: true]
        cloud_region_uuid [label: "cloud_region_uuid", type: "text", fk: true, null: true]
        cloud_credential_uuid [label: "cloud_credential_uuid", type: "text", fk: true, null: true]
        model_type_id [label: "model_type_id", type: "int", fk: true]
        life_id [label: "life_id", type: "int", fk: true]
        name [label: "name", type: "text"]
        qualifier [label: "qualifier", type: "text"]
