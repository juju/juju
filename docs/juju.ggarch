// --------------------------------------------------------------------------
// Intro diagram 1: The problem
// --------------------------------------------------------------------------

diagram "Intro: the problem" from "Juju" {
  select {
    nodes: user bare_application
    edges: type control
    sizing: uniform
    instances: bare_application [
      { id: app1, label: "application 1" },
      { id: app2, label: "application 2" },
      { id: app3, label: "application 3" }
    ]
  }
  positions {
    user  left-of app1
    user  align-middle app2
    app1  above app2
    app1  align-centre app2
    app3  below app2
    app3  align-centre app2
  }
}

// --------------------------------------------------------------------------
// Intro diagram 2: Juju enters
// Controller in centre. Clouds fanned above. Charmhub below. Apps fanned right.
// --------------------------------------------------------------------------

diagram "Intro: Juju enters" from "Juju" {
  select {
    nodes: user client controller cloud charmhub application
    edges: type control type api
    // The intro shows the delta over "the problem": Juju machinery
    // between the user and the applications. Bootstrap (client <-> cloud)
    // and the cloud -> controller provisioning return path are left to
    // "Juju overview" and the sequence views.
    except: client -> cloud cloud -> client cloud -> controller
    sizing: uniform
    // Model-membership boxes and record chips are OFF here pending a
    // redesign (2026-09-20 reviewer call: the boxes crowd the app
    // column and the chips collide with the fan labels; both come
    // back when their placement design is worked out -- see HANDOFF
    // known issues).
    instances: cloud [
      { id: cloud_a, label: "cloud 1" },
      { id: cloud_b, label: "cloud 2" }
    ]
    // Instance from the base kind (application), not the collective
    // (apps): the collective's stack glyph would contradict the
    // individuated form the intro argues in ("like Intro: the
    // problem").
    instances: application [
      { id: app1, label: "app 1" },
      { id: app2, label: "app 2" },
      { id: app3, label: "app 3" }
    ]
  }
  positions {
    // Horizontal spine
    user       left-of client
    user       align-middle client
    client     left-of controller
    client     align-middle controller
    // Clouds fanned above controller, centred on it: the spacing is
    // sized for the two "provisions on" labels to clear each other
    // (the default packs the fan into near-parallel arrows).
    fan [cloud_a cloud_b] above controller    gap: 40 spacing: 120
    // Charmhub below controller
    charmhub   below controller    gap: 40
    charmhub   align-centre controller
    // Apps fanned to the right of controller: the gap is sized for
    // the labels -- three "converges toward" strokes into the
    // mid-east face need the run for their labels to separate.
    fan [app1 app2 app3] right-of controller gap: 140
  }
  annotations {
    // Model-membership boxes removed 2026-09-20 (reviewer call: they
    // crowd the app column) -- they return when the box placement
    // design is reworked; see HANDOFF known issues.
    legend [position: "bottom-right",
            person: "operator",
            juju-software: "Juju process",
            external: "cloud / external",
            charm: "charmed application",
            control: "manages / drives",
            api: "API call"]
  }
}

// --------------------------------------------------------------------------
// Intro diagram 3: Juju unpacked
// Same layout; unit containers expose agent → charm → workload.
// Scope chips on each unit container.
// --------------------------------------------------------------------------

diagram "Intro: Juju unpacked" from "Juju" {
  select {
    nodes: user client controller unit_pod
    edges: type control type stream type api
    // One arrow per path: the watch stream is the salient channel
    // (communication always starts from the unit agent). The api
    // duplicate belongs to the sequence views.
    except: unit_agent -> controller [type: api]
    instances: unit_pod [
      { id: u_app1_0, label: "unit: app1/0" },
      { id: u_app2_0, label: "unit: app2/0" },
      { id: u_app3_0, label: "unit: app3/0" }
    ]
  }
  positions {
    user       left-of client
    user       align-middle client
    client     left-of controller
    client     align-middle controller
    // Units fanned to the right of controller
    fan [u_app1_0 u_app2_0 u_app3_0] right-of controller gap: 20
    u_app1_0 direction: right
    u_app2_0 direction: right
    u_app3_0 direction: right
  }
  annotations {
    legend [position: "bottom-right",
            juju-software: "Juju process",
            container: "Juju-owned pod",
            charm: "charm code",
            workload: "workload (external)",
            control: "manages / drives",
            stream: "watch (async)",
            api: "API call"]
  }
}

// --------------------------------------------------------------------------
// HA controller — Dqlite replicaset
// --------------------------------------------------------------------------

diagram "HA controller: Dqlite replicaset" from "Juju" {
  select {
    nodes: controller_node
    edges: type stream
    // Associative view: the RESULT of Raft sync (a replicaset in
    // sync), not the interaction — the sync messages belong to a
    // sequence view (review round 3: emergent state vs interaction).
    // (The old `except: ha_agent -> ha_agent` here killed the WHOLE
    // mesh: the expansion of the mesh self edge already renders only
    // the cross-instance pairs, no self-loops — the except suppressed
    // the model edge before stamping and the view drew three bare
    // boxes. Found by the round-24 orphan check.)
    instances: controller_node [
      { id: c1, label: "Controller 1" },
      { id: c2, label: "Controller 2" },
      { id: c3, label: "Controller 3" }
    ]
  }
  positions {
    // Controller copies side by side (user review round 2); Dqlite is
    // embedded in Juju 4.0, so the Raft mesh runs between the agents.
    c1 left-of c2  gap: 100
    c1 align-middle c2
    c2 left-of c3  gap: 100
    c2 align-middle c3
  }
  annotations {
    legend [position: "bottom-right",
            container: "controller node",
            juju-software: "controller agent (embedded Dqlite)"]
  }
}




