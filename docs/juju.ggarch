// Task status changes, from the 4.1 code:
//   domain/operation/state/start.go:600-632 (a task starts pending)
//   domain/operation/state/task.go:137-213 (StartTask: pending -> running)
//   domain/operation/state/task.go:485-507 (CancelTask: pending -> cancelled,
//     running -> aborting)
//   internal/worker/uniter/runner/context/context.go:1771-1786 (finalizeAction:
//     completed, failed, or aborted when the task was aborting)
model "TaskStatusChanges" {

  nodes {
    ts_pending   [label: "pending"]
    ts_running   [label: "running"]
    ts_cancelled [label: "cancelled"]
    ts_aborting  [label: "aborting"]
    ts_completed [label: "completed"]
    ts_failed    [label: "failed"]
    ts_aborted   [label: "aborted"]
  }

  behaviours {
    behaviour "task-status" {
      ts_pending  -> ts_running:   call "agent starts the task"
      ts_pending  -> ts_cancelled: call "cancel"
      ts_running  -> ts_aborting:  call "cancel"
      ts_running  -> ts_completed: call "agent reports success"
      ts_running  -> ts_failed:    call "agent reports failure"
      ts_aborting -> ts_aborted:   call "agent reports the abort"
      ts_aborting -> ts_completed: call "agent reports success"
      ts_aborting -> ts_failed:    call "agent reports failure"
    }
  }

  edges {
    ts_pending  -> ts_running   [type: control]
    ts_pending  -> ts_cancelled [type: control]
    ts_running  -> ts_aborting  [type: control]
    ts_running  -> ts_completed [type: control]
    ts_running  -> ts_failed    [type: control]
    ts_aborting -> ts_aborted   [type: control]
    ts_aborting -> ts_completed [type: control]
    ts_aborting -> ts_failed    [type: control]
  }

  style { extends: juju }
}

state "Task status" from "TaskStatusChanges" {
  select { behaviour: "task-status" }
}

// Running an action, from the 4.1 code:
//   1 apiserver/facades/client/action/operation.go:32-134 (EnqueueOperation)
//   2 apiserver/facades/agent/uniter/uniter.go:1012-1060 (WatchActionNotifications)
//   3 uniter.go:1228-1260 (Actions: only a pending task)
//   4 uniter.go:1264-1285 (BeginActions -> StartTask)
//   5 internal/worker/uniter/runner/jujuc/action-log.go:44-46 -> uniter.go:1338-1360
//   6 runner/context/context.go:1771-1827 (finalizeAction) -> uniter.go:1309-1335
model "ActionRun" {

  nodes {
    ar_client     [type: juju-software, label: "Client"]
    ar_controller [type: juju-software, label: "Controller"]
    ar_agent      [type: juju-software, label: "Unit agent"]
    ar_charm      [type: workload, label: "Charm action code"]
  }

  edges {
    ar_client     -> ar_controller [type: api]
    ar_agent      -> ar_controller [type: api]
    ar_agent      -> ar_charm      [type: control]
  }

  behaviours {
    behaviour "run-action" {
      ar_client     -> ar_controller: call "enqueue the action on a unit"
      ar_controller -> ar_controller: self "store the operation and one pending task per unit"
      ar_controller -> ar_client:     return "operation and task IDs"
      ar_controller -> ar_agent:      async "notify of the pending task"
      ar_agent      -> ar_controller: call "get the task, then mark it running"
      ar_agent      -> ar_charm:      call "run the action with its parameters"
      ar_charm      -> ar_agent:      return "progress messages, results, and failure"
      ar_agent      -> ar_controller: call "log progress, then record status, results, and message"
    }
  }

  style { extends: juju }
}

sequence "Running actions" from "ActionRun" {
  select { behaviour: "run-action" }
}

